package kiev.ir.java15;

import syntax kiev.Syntax;

/**
 * @author Maxim Kizub
 *
 */

@ViewOf(vcast=true)
public abstract view RBoolExpr of BoolExpr extends RENode {

	public static void checkBool(ENode e, StdTypes tenv) {
		Type et = e.getType();
		if (et.isBoolean())
			return;
		if (et ≡ tenv.tpRule) {
			((RENode)e).replaceWithResolve(tenv.tpBoolean, fun ()->ENode {
				return new BinaryBoolExpr(e.pos,tenv.env.coreFuncs.fObjectBoolNE,e,new ConstNullExpr());
			});
			return;
		}
		if (et instanceof CallType && e instanceof ClosureCallExpr && e.isKindAuto()) {
			CallType ct = (CallType)et;
			if (ct.arity == 0 && ct.ret().getAutoCastTo(tenv.tpBoolean) != null) {
				((ClosureCallExpr)e).kind = ClosureCallKind.CALL;
				return;
			}
		}
		throw new RuntimeException("Expression "+e+" must be of boolean type, but found "+e.getType());
	}

}

@ViewOf(vcast=true)
public final view RBinaryBooleanOrExpr of BinaryBooleanOrExpr extends RBoolExpr {
	public ENode		expr1;
	public ENode		expr2;

	public void resolveENode(Type reqType) {
		resolveENode(expr1,tenv.tpBoolean);
		RBoolExpr.checkBool(expr1, tenv);
		resolveENode(expr2,tenv.tpBoolean);
		RBoolExpr.checkBool(expr2, tenv);
		setResolved(true);
		if (isAutoReturnable())
			RReturnStat.autoReturn(reqType, this);
	}
}

@ViewOf(vcast=true)
public final view RBinaryBooleanAndExpr of BinaryBooleanAndExpr extends RBoolExpr {
	public ENode		expr1;
	public ENode		expr2;

	public void resolveENode(Type reqType) {
		resolveENode(expr1,tenv.tpBoolean);
		RBoolExpr.checkBool(expr1, tenv);
		resolveENode(expr2,tenv.tpBoolean);
		RBoolExpr.checkBool(expr2, tenv);
		setResolved(true);
		if (isAutoReturnable())
			RReturnStat.autoReturn(reqType, this);
	}
}

@ViewOf(vcast=true)
public view RBinaryBoolExpr of BinaryBoolExpr extends RBoolExpr {
	public ENode			expr1;
	public ENode			expr2;

	public void resolveENode(Type reqType) {
		if( isResolved() ) return;

		Method m = resolveMethodAndNormalize();
		if (m == null)
			return; // error already reported
		if (m.isStatic()) {
			m.makeArgs(getEArgs(),reqType);
			resolveENode(expr1,m.params[0].getType());
			resolveENode(expr2,m.params[1].getType());
		} else {
			m.makeArgs(new ENode[]{expr2},reqType);
			resolveENode(expr1,((TypeDecl)m.parent()).getType());
			resolveENode(expr2,m.params[0].getType());
		}
		if !(m instanceof CoreOperation) {
			// Not a standard operator
			if( m.isStatic() )
				replaceWithNodeResolve(reqType, new CallExpr(pos,null,m,new ENode[]{~expr1,~expr2}));
			else
				replaceWithNodeResolve(reqType, new CallExpr(pos,~expr1,m,new ENode[]{~expr2}));
			return;
		}
		// Check if both expressions are constant
		if (isConstantExpr()) {
			replaceWithNodeResolve(reqType, ((CoreOperation)m).calc(this));
			return;
		}

		setResolved(true);
		if (isAutoReturnable())
			RReturnStat.autoReturn(reqType, this);
	}
}

@ViewOf(vcast=true)
public view RInstanceofExpr of InstanceofExpr extends RBoolExpr {
	public ENode	expr;
	public TypeRef	itype;

	public void resolveENode(Type reqType) {
		if( isResolved() ) return;
		resolveENode(expr,null);
		Type tp = null;
		if( expr instanceof TypeRef )
			tp = ((TypeRef)expr).getType();
		if( tp != null ) {
			InstanceofExpr self = (InstanceofExpr)this;
			replaceWithNode(new ConstBoolExpr(tp.isInstanceOf(itype.getType())), self.parent(), self.pslot());
			return;
		} else {
			Type et = expr.getType();
			if (!expr.isForWrapper() && et instanceof CTimeType) {
				expr = et.makeUnboxedExpr(expr);
				expr.setForWrapper(true);
				resolveENode(expr,null);
			}
		}
		tp = itype.getType();
		if( !expr.getType().isCastableTo(tp) ) {
			throw new CompilerException(this,"Type "+expr.getType()+" is not castable to "+itype);
		}
		if (expr.getType().isInstanceOf(tp) && !tp.isUnerasable()) {
			replaceWithNodeResolve(reqType,
				new BinaryBoolExpr(pos, coreFuncs.fObjectBoolNE,~expr,new ConstNullExpr()));
			return;
		}
		while (tp instanceof CTimeType)
			tp = tp.getEnclosedType();
		if (tp.isUnerasable()) {
			replaceWithNodeResolve(reqType, new CallExpr(pos,
					new TypeInfoExpr(itype.getType()),
					tenv.tpTypeInfo.tdecl.resolveMethod("$instanceof",tenv.tpBoolean,tenv.tpObject),
					new ENode[]{~expr}
					)
				);
			return;
		}
		setResolved(true);
		if (isAutoReturnable())
			RReturnStat.autoReturn(reqType, this);
	}
}

@ViewOf(vcast=true)
public view RBooleanNotExpr of BooleanNotExpr extends RBoolExpr {
	public ENode		expr;

	public void resolveENode(Type reqType) {
		if( isResolved() ) return;

		Method m = resolveMethodAndNormalize();
		if (m == null)
			return; // error already reported
		if (m.isStatic()) {
			m.makeArgs(getEArgs(),reqType);
			resolveENode(expr,m.params[0].getType());
		} else {
			m.makeArgs(ENode.emptyArray,reqType);
			resolveENode(expr,((TypeDecl)m.parent()).getType());
		}
		if !(m instanceof CoreOperation) {
			// Not a standard operator
			if( m.isStatic() )
				replaceWithNodeResolve(reqType, new CallExpr(pos,null,m,new ENode[]{~expr}));
			else
				replaceWithNodeResolve(reqType, new CallExpr(pos,~expr,m,ENode.emptyArray));
			return;
		}
		RBoolExpr.checkBool(expr, tenv);
		// Check if expression is a constant
		if (isConstantExpr()) {
			replaceWithNodeResolve(reqType, ((CoreOperation)m).calc(this));
			return;
		}
		setResolved(true);
		if (isAutoReturnable())
			RReturnStat.autoReturn(reqType, this);
	}
}

