		public Object applyToIfElseStat(IfElseStat node, Object arg) { new RIfElseStat(node) }
		public Object applyToCondStat(CondStat node, Object arg) { new RCondStat(node) }
		public Object applyToLabeledStat(LabeledStat node, Object arg) { new RLabeledStat(node) }
		public Object applyToBreakStat(BreakStat node, Object arg) { new RBreakStat(node) }
		public Object applyToContinueStat(ContinueStat node, Object arg) { new RContinueStat(node) }
		public Object applyToGotoStat(GotoStat node, Object arg) { new RGotoStat(node) }
		public Object applyToGotoCaseStat(GotoCaseStat node, Object arg) { new RGotoCaseStat(node) }
		public Object applyToCaseLabel(CaseLabel node, Object arg) { new RCaseLabel(node) }
		public Object applyToSwitchStat(SwitchStat node, Object arg) { new RSwitchStat(node) }
		public Object applyToSwitchEnumStat(SwitchEnumStat node, Object arg) { new RSwitchEnumStat(node) }
		public Object applyToSwitchTypeStat(SwitchTypeStat node, Object arg) { new RSwitchTypeStat(node) }
		public Object applyToMatchStat(MatchStat node, Object arg) { new RMatchStat(node) }
		public Object applyToCatchInfo(CatchInfo node, Object arg) { new RCatchInfo(node) }
		public Object applyToFinallyInfo(FinallyInfo node, Object arg) { new RFinallyInfo(node) }
		public Object applyToTryStat(TryStat node, Object arg) { new RTryStat(node) }

		public Object applyToDNode(DNode node, Object arg) { new RDNode(node) }
		public Object applyToVar(Var node, Object arg) { new RVar(node) }
		public Object applyToField(Field node, Object arg) { new RField(node) }
		public Object applyToTypeDecl(TypeDecl node, Object arg) { new RTypeDecl(node) }
		public Object applyToComplexTypeDecl(ComplexTypeDecl node, Object arg) { new RComplexTypeDecl(node) }
		public Object applyToStruct(Struct node, Object arg) { new RStruct(node) }
		public Object applyToMethod(Method node, Object arg) { new RMethod(node) }
		public Object applyToConstructor(Constructor node, Object arg) { new RConstructor(node) }
