package kiev.ir.java15;

import syntax kiev.Syntax;

import kiev.transf.PluginNodeProcessor;

/**
 * @author Maxim Kizub
 *
 */

public class RFactory {

	static RDispatcher makeViewDispatcher = new RDispatcher();

	static class RDispatcher extends LogicLang.DispatcherC {
		public Object applyToASTNode(ASTNode node, Object arg) { new RNode(node) }

		public Object applyToENode(ENode node, Object arg) { new RENode(node) }
		public Object applyToNopExpr(NopExpr node, Object arg) { new RNopExpr(node) }
		public Object applyToArgExpr(ArgExpr node, Object arg) { new RArgExpr(node) }
		public Object applyToTypeRef(TypeRef node, Object arg) { new RTypeRef(node) }
		public Object applyToCoreExpr(CoreExpr node, Object arg) { new RCoreExpr(node) }
		public Object applyToShadow(Shadow node, Object arg) { new RShadow(node) }
		public Object applyToTypeClassExpr(TypeClassExpr node, Object arg) { new RTypeClassExpr(node) }
		public Object applyToTypeInfoExpr(TypeInfoExpr node, Object arg) { new RTypeInfoExpr(node) }
		public Object applyToAssertEnabledExpr(AssertEnabledExpr node, Object arg) { new RAssertEnabledExpr(node) }
		public Object applyToAssignExpr(AssignExpr node, Object arg) { new RAssignExpr(node) }
		public Object applyToModifyExpr(ModifyExpr node, Object arg) { new RModifyExpr(node) }
		public Object applyToBinaryExpr(BinaryExpr node, Object arg) { new RBinaryExpr(node) }
		public Object applyToUnaryExpr(UnaryExpr node, Object arg) { new RUnaryExpr(node) }
		public Object applyToStringConcatExpr(StringConcatExpr node, Object arg) { new RStringConcatExpr(node) }
		public Object applyToCommaExpr(CommaExpr node, Object arg) { new RCommaExpr(node) }
		public Object applyToBlock(Block node, Object arg) { new RBlock(node) }
		public Object applyToIncrementExpr(IncrementExpr node, Object arg) { new RIncrementExpr(node) }
		public Object applyToConditionalExpr(ConditionalExpr node, Object arg) { new RConditionalExpr(node) }
		public Object applyToCastExpr(CastExpr node, Object arg) { new RCastExpr(node) }
		public Object applyToConstExpr(ConstExpr node, Object arg) { new RConstExpr(node) }
		public Object applyToBoolExpr(BoolExpr node, Object arg) { new RBoolExpr(node) }
		public Object applyToBinaryBooleanOrExpr(BinaryBooleanOrExpr node, Object arg) { new RBinaryBooleanOrExpr(node) }
		public Object applyToBinaryBooleanAndExpr(BinaryBooleanAndExpr node, Object arg) { new RBinaryBooleanAndExpr(node) }
		public Object applyToBinaryBoolExpr(BinaryBoolExpr node, Object arg) { new RBinaryBoolExpr(node) }
		public Object applyToInstanceofExpr(InstanceofExpr node, Object arg) { new RInstanceofExpr(node) }
		public Object applyToBooleanNotExpr(BooleanNotExpr node, Object arg) { new RBooleanNotExpr(node) }
		public Object applyToCallExpr(CallExpr node, Object arg) { new RCallExpr(node) }
