		public Object applyToClosureCallExpr(ClosureCallExpr node, Object arg) { new RClosureCallExpr(node) }
		public Object applyToLvalueExpr(LvalueExpr node, Object arg) { new RLvalueExpr(node) }
		public Object applyToAccessExpr(AccessExpr node, Object arg) { new RAccessExpr(node) }
		public Object applyToIFldExpr(IFldExpr node, Object arg) { new RIFldExpr(node) }
		public Object applyToContainerAccessExpr(ContainerAccessExpr node, Object arg) { new RContainerAccessExpr(node) }
		public Object applyToThisExpr(ThisExpr node, Object arg) { new RThisExpr(node) }
		public Object applyToSuperExpr(SuperExpr node, Object arg) { new RSuperExpr(node) }
		public Object applyToLVarExpr(LVarExpr node, Object arg) { new RLVarExpr(node) }
		public Object applyToSFldExpr(SFldExpr node, Object arg) { new RSFldExpr(node) }
		public Object applyToOuterThisAccessExpr(OuterThisAccessExpr node, Object arg) { new ROuterThisAccessExpr(node) }
		public Object applyToReinterpExpr(ReinterpExpr node, Object arg) { new RReinterpExpr(node) }
		public Object applyToNewExpr(NewExpr node, Object arg) { new RNewExpr(node) }
