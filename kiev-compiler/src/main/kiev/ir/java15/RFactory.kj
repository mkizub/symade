		public Object applyToWithStat(WithStat node, Object arg) { new RWithStat(node) }
		public Object applyToLoopStat(LoopStat node, Object arg) { new RLoopStat(node) }
		public Object applyToLabel(Label node, Object arg) { new RLabel(node) }
		public Object applyToWhileStat(WhileStat node, Object arg) { new RWhileStat(node) }
		public Object applyToDoWhileStat(DoWhileStat node, Object arg) { new RDoWhileStat(node) }
		public Object applyToForStat(ForStat node, Object arg) { new RForStat(node) }
		public Object applyToForEachStat(ForEachStat node, Object arg) { new RForEachStat(node) }
