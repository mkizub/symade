package kiev.compiler;
import syntax kiev.Syntax;


public class EditorThreadGroup extends WorkerThreadGroup {
	public EditorThreadGroup(WorkerThreadGroup bthr) {
		this(bthr, bthr.jobThreads);
	}
	public EditorThreadGroup(WorkerThreadGroup bthr, int jobThreads) {
		super(bthr, "editor", jobThreads);
		semantic_context = new SemanticContext(bthr.semantic_context);
	}
}

