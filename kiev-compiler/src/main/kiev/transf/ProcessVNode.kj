package kiev.transf;

import syntax kiev.Syntax;

import kiev.compiler.WorkerThreadGroup;

import static kiev.transf.VNodeUtils.*;

/**
 * @author Maxim Kizub
 *
 */

public final class VNodePlugin implements PluginFactory {
	public PluginDescr getPluginDescr(String name) {
		PluginDescr pd = null;
		if (name.equals("vnode")) {
			pd = new PluginDescr("vnode").depends("kiev");
			pd.proc(new ProcessorDescr("pass3", "fe", 100, VNodeFE_Pass3.class).after("kiev:fe:pass3"));
			pd.proc(new ProcessorDescr("gen-members", "fe", 0, VNodeFE_GenMembers.class).after("vnode:fe:pass3").before("kiev:fe:pre-resolve"));
			pd.proc(new ProcessorDescr("gen-dispatch", "fe", 0, VNodeFE_GenDispatch.class).after("kiev:fe:pre-resolve").before("kiev:fe:main-resolve"));
			pd.proc(new ProcessorDescr("verify", "fv", 0, VNodeFE_Verify.class));
			pd.proc(new ProcessorDescr("pre-generate", "me", 0, VNodeME_PreGenerate.class).after("view:me:pre-generate").after("virt-fld:me:pre-generate"));
			pd.proc(new ProcessorDescr("fix-resolve", "be", 0, VNodeBE_FixResolve.class).after("kiev:be:resolve").before("kiev:be:generate").before("virt-fld:be:rewrite"));
		}
		return pd;
	}
}

public final class VNodeUtils {
	private static final String PROP_BASE				= "symade.transf.vnode";
	public static final String mnNode					= TransfProcessor.getPropS(PROP_BASE,"mnNode","kiev·vtree·ThisIsANode");
	public static final String mnAtt					= TransfProcessor.getPropS(PROP_BASE,"mnAtt","kiev·vtree·nodeAttr");
	public static final String mnRef					= TransfProcessor.getPropS(PROP_BASE,"mnRef","kiev·vtree·nodeData");
	public static final String mnSym					= TransfProcessor.getPropS(PROP_BASE,"mnSym","kiev·vtree·nodeSymb");
	public static final String mnLanguage				= TransfProcessor.getPropS(PROP_BASE,"mnLanguage","kiev·vtree·ThisIsALanguage");
	public static final String mnUnVersioned			= TransfProcessor.getPropS(PROP_BASE,"mnUnVersioned","kiev·vtree·UnVersioned");
	public static final String nameINode				= TransfProcessor.getPropS(PROP_BASE,"nameINode","kiev·vtree·INode");
	public static final String nameANode				= TransfProcessor.getPropS(PROP_BASE,"nameANode","kiev·vtree·ANode");
	public static final String nameNode					= TransfProcessor.getPropS(PROP_BASE,"nameNode","kiev·vtree·ANode");
	public static final String nameNodeTypeInfo			= TransfProcessor.getPropS(PROP_BASE,"nameNodeTypeInfo","kiev·vtree·NodeTypeInfo");
	public static final String nameNodeSpace			= TransfProcessor.getPropS(PROP_BASE,"nameNodeSpace","kiev·vtree·NodeSpace");
	public static final String nameNodeExtSpace			= TransfProcessor.getPropS(PROP_BASE,"nameNodeExtSpace","kiev·vtree·NodeExtSpace");
	public static final String nameNodeSymbolRef		= TransfProcessor.getPropS(PROP_BASE,"nameNodeSymbolRef","kiev·vtree·NodeSymbolRef");
	public static final String nameTreeWalker			= TransfProcessor.getPropS(PROP_BASE,"TreeWalker","kiev·vtree·TreeWalker");
	public static final String nameAttrSlot				= TransfProcessor.getPropS(PROP_BASE,"nameAttrSlot","kiev·vtree·AttrSlot");
	public static final String nameScalarAttrSlot		= TransfProcessor.getPropS(PROP_BASE,"nameScalarAttrSlot","kiev·vtree·ScalarAttrSlot");
	public static final String nameExtAttrSlot			= TransfProcessor.getPropS(PROP_BASE,"nameExtAttrSlot","kiev·vtree·ExtAttrSlot");
	public static final String nameSpaceAttrSlot		= TransfProcessor.getPropS(PROP_BASE,"nameSpaceAttrSlot","kiev·vtree·SpaceAttrSlot");
	public static final String nameExtSpaceAttrSlot		= TransfProcessor.getPropS(PROP_BASE,"nameExtSpaceAttrSlot","kiev·vtree·ExtSpaceAttrSlot");
	public static final String nameParentAttrSlot		= TransfProcessor.getPropS(PROP_BASE,"nameParentAttrSlot","kiev·vtree·ParentAttrSlot");
	public static final String nameLanguageIface		= TransfProcessor.getPropS(PROP_BASE,"nameLanguageIface","kiev·vlang·Language");
	public static final String nameLanguageDispatcherI	= TransfProcessor.getPropS(PROP_BASE,"nameLanguageDispatcher","kiev·vlang·Language·DispatcherI");
	public static final String nameLanguageDispatcherC	= TransfProcessor.getPropS(PROP_BASE,"nameLanguageDispatcher","kiev·vlang·Language·DispatcherC");
	public static final String nameCopyContext			= TransfProcessor.getPropS(PROP_BASE,"nameCopyContext","kiev·vtree·CopyContext");
	public static final String nameCopyable				= TransfProcessor.getPropS(PROP_BASE,"nameCopyable","copyable");
	public static final String nameExtData				= TransfProcessor.getPropS(PROP_BASE,"nameExtData","ext_data");
	public static final String nameNodeName				= TransfProcessor.getPropS(PROP_BASE,"nameNodeName","name");
	public static final String nameLangName				= TransfProcessor.getPropS(PROP_BASE,"nameLangName","lang");
	public static final String nameCallbackDataSet		= TransfProcessor.getPropS(PROP_BASE,"nameCallbackDataSet","callbackDataSet");

	public static final String operatorPostTypeSpace	= TransfProcessor.getPropS(PROP_BASE,"operatorPostTypeSpace","T ∅");		// \u2205
	public static final String operatorPostTypeExtSpace	= TransfProcessor.getPropS(PROP_BASE,"operatorPostTypeExtSpace","T ⋈");		// \u22c8
	public static final String operatorPostTypeSymbolRef= TransfProcessor.getPropS(PROP_BASE,"operatorPostTypeSymbolRef","T ⇑");	// \u21d1

	Type tpINode;
	Type tpANode;
	Type tpNode;
	Type tpNodeTypeInfo;
	Type tpNArray;
	Type tpNodeSpace;
	Type tpNodeExtSpace;
	Type tpNodeSymbolRef;
	Type tpTreeWalker;
	Type tpAttrSlot;
	Type tpScalarAttrSlot;
	Type tpExtAttrSlot;
	Type tpSpaceAttrSlot;
	Type tpExtSpaceAttrSlot;
	Type tpParentAttrSlot;
	Type tpLanguageIface;
	Type tpCopyContext;

	Operator PostTypeSpace;
	Operator PostTypeExtSpace;
	Operator PostTypeSymbolRef;

	public static boolean isNodeImpl(Struct s) {
		return s.isClazz() && s.getMeta(mnNode) != null;
	}
	public static boolean isNodeKind(Struct s) {
		return s.getMeta(mnNode) != null;
	}
	public static boolean isNodeKind(Type t) {
		if (t != null && t.getStruct() != null)
			return isNodeKind(t.getStruct());
		return false;
	}
	public static boolean isLanguageImpl(Struct s) {
		return s.getMeta(mnLanguage) != null;
	}

	VNodeUtils(ANodeContext context) {
		final Env env = context.theEnv;
		tpINode = env.loadTypeDecl(nameINode, true, context).getType();
		tpANode = env.loadTypeDecl(nameANode, true, context).getType();
		tpNode = env.loadTypeDecl(nameNode, true, context).getType();
		tpNodeTypeInfo = env.loadTypeDecl(nameNodeTypeInfo, true, context).getType();
		tpNArray = new ArrayType(tpANode);
		tpNodeSpace = env.loadTypeDecl(nameNodeSpace, true, context).getType();
		tpNodeExtSpace = env.loadTypeDecl(nameNodeExtSpace, true, context).getType();
		tpNodeSymbolRef = env.loadTypeDecl(nameNodeSymbolRef, true, context).getType();
		tpTreeWalker = env.loadTypeDecl(nameTreeWalker, true, context).getType();
		tpAttrSlot = env.loadTypeDecl(nameAttrSlot, true, context).getType();
		tpScalarAttrSlot = env.loadTypeDecl(nameScalarAttrSlot, true, context).getType();
		tpExtAttrSlot = env.loadTypeDecl(nameExtAttrSlot, true, context).getType();
		tpSpaceAttrSlot = env.loadTypeDecl(nameSpaceAttrSlot, true, context).getType();
		tpExtSpaceAttrSlot = env.loadTypeDecl(nameExtSpaceAttrSlot, true, context).getType();
		tpParentAttrSlot = env.loadTypeDecl(nameParentAttrSlot, true, context).getType();
		tpLanguageIface = env.loadTypeDecl(nameLanguageIface, true, context).getType();
		tpCopyContext = env.loadTypeDecl(nameCopyContext, true, context).getType();

		PostTypeSpace = Operator.getOperatorByName(operatorPostTypeSpace);
		PostTypeExtSpace = Operator.getOperatorByName(operatorPostTypeExtSpace);
		PostTypeSymbolRef = Operator.getOperatorByName(operatorPostTypeSymbolRef);
	}
}

/////////////////////////////////////////////
//      Verify the VNode tree structure    //
/////////////////////////////////////////////

public final class VNodeFE_Pass3 extends TransfProcessor {

	@forward
	private VNodeUtils utils;

	public VNodeFE_Pass3(Env env, int id) { super(env,id,KievExt.VNode); }

	public String getDescr() { "VNode members creation" }

	public void process(ANode node, Transaction tr) {
		if (node instanceof CompilationUnit) {
			CompilationUnit cu = (CompilationUnit)node;
			WorkerThreadGroup wthg = (WorkerThreadGroup)Thread.currentThread().getThreadGroup();
			if (wthg.setProcessorRun(cu,this))
				return;
			if (utils == null)
				utils = new VNodeUtils(getContext());
			tr = Transaction.enter(tr,"VNodeFE_Pass3");
			try {
				doProcess(node);
			} finally { tr.leave(); }
		}
	}

	public void doProcess(ANode:ANode node) {
	}

	public void doProcess(SyntaxScope:ANode ss) {
		foreach (ANode n; ss.members)
			doProcess(n);
	}

	public void doProcess(Struct:ANode s) {
		foreach (Struct sub; s.members)
			doProcess(sub);
		if (VNodeUtils.isNodeKind(s)) {
			if (nameNode.equals(s.qname()))
				return;
			// Check fields of the @ThisIsANode
			foreach (Field n; s.members)
				doProcess(n);
			return;
		}

		// Check fields to not have @nodeAttr and @nodeData
		foreach (Field f; s.members) {
			UserMeta fmatt = (UserMeta)f.getMeta(mnAtt);
			UserMeta fmref = (UserMeta)f.getMeta(mnRef);
			UserMeta fmsym = (UserMeta)f.getMeta(mnSym);
			if (fmatt != null || fmref != null || fmsym != null) {
				f.reportWarning().log("Field "+f+" of non-@node class "+Env.ctxTDecl(f)+" may not be @nodeAttr or @nodeData or @nodeSymb");
			}
		}
	}

	public void doProcess(Field:ANode f) {
		UserMeta fmatt = (UserMeta)f.getMeta(mnAtt);
		UserMeta fmref = (UserMeta)f.getMeta(mnRef);
		UserMeta fmsym = (UserMeta)f.getMeta(mnSym);
		//if (fmatt != null || fmref != null) {
		//	System.out.println("process @node: field "+f+" has @nodeAttr="+fmatt+" and @nodeData="+fmref);
		if (fmatt != null && fmref != null) {
			f.reportError().log("Field {}.{} marked both @nodeAttr and @nodeData", Env.ctxTDecl(f), f);
		}
		if (fmatt != null || fmref != null || fmsym != null) {
			if (f.isStatic())
				f.reportError().log("Field {}.{} is static and cannot have @nodeAttr or @nodeData or @nodeSymb", Env.ctxTDecl(f), f);
			boolean isArr = false;
			{
				Type ft = f.getType();
				boolean isExtData = fmatt != null ? fmatt.getZ(nameExtData) : fmref.getZ(nameExtData);
				if (ft.isInstanceOf(tpNArray)) {
					if (!isExtData) {
						if (!ft.isInstanceOf(tpNodeSpace))
							f.reportError().log("Use node space operator '{}' instead of 'T []'", operatorPostTypeSpace);
					} else {
						if (!ft.isInstanceOf(tpNodeExtSpace))
							f.reportError().log("Use node extended space operator '{}' instead of 'T []'", operatorPostTypeExtSpace); // ⋈
					}
					if (ft.isInstanceOf(tpNodeExtSpace)) {
						if (!f.isAbstract())
							f.setAbstract(true);
						if (f.isVirtual())
							f.setVirtual(false);
					}
					isArr = true;
				}
			}
			//System.out.println("process @node: field "+f+" of type "+fs+" has correct @nodeAttr="+fmatt+" or @nodeData="+fmref);
			if (isArr && f.init != null && !f.init.isAutoGenerated()) {
				f.reportError().log("Field {}.{} may not have initializer", Env.ctxTDecl(f), f);
			}
		}
		else if (!f.isStatic() && !f.isInterfaceOnly() && !f.isAbstract()) {
			if (f.getType().isInstanceOf(tpNArray))
				f.reportWarning().log("Field "+Env.ctxTDecl(f)+"."+f+" must be marked with @nodeAttr or @nodeData");
			else if (VNodeUtils.isNodeKind(f.getType()))
				f.reportWarning().log("Field "+Env.ctxTDecl(f)+"."+f+" must be marked with @nodeAttr or @nodeData");
		}
		if (!f.isStatic() && !f.isAbstract() && !f.isFinal() && f.getMeta(mnUnVersioned) == null)
			f.setVirtual(true);
	}
}

//////////////////////////////////////////////////////
//   Generate class members (enumerate sub-nodes)   //
//////////////////////////////////////////////////////

public final class VNodeFE_GenMembers extends TransfProcessor {
	public VNodeFE_GenMembers(Env env, int id) { super(env,id,KievExt.VNode); }
	public String getDescr() { "VNode members generation" }

	@forward
	private VNodeUtils utils;
	private Vector<Struct> processed;

	private Type makeNodeAttrClass(Struct snode, Field f) {
		UserMeta fmatt = (UserMeta)f.getMeta(mnAtt);
		UserMeta fmref = (UserMeta)f.getMeta(mnRef);
		boolean isAtt = (fmatt != null);
		boolean isSet = f.getType().isInstanceOf(tpNodeExtSpace);
		boolean isArr = f.getType().isInstanceOf(tpNodeSpace);
		boolean isExtData = isAtt ? fmatt.getZ(nameExtData) : fmref.getZ(nameExtData);
		Type ft = f.getType();
		Type clz_tp = (isArr || isSet) ? ft.resolveArg(0) : ft;
		//if (clz_tp ≡ env.tenv.tpInt);
		//else if (clz_tp ≡ env.tenv.tpBoolean);
		//else if (clz_tp ≡ env.tenv.tpChar);
		//else if (clz_tp ≡ env.tenv.tpByte);
		//else if (clz_tp ≡ env.tenv.tpShort);
		//else if (clz_tp ≡ env.tenv.tpLong);
		//else if (clz_tp ≡ env.tenv.tpFloat);
		//else if (clz_tp ≡ env.tenv.tpDouble);
		//else if (clz_tp ≈ env.tenv.tpString);
		//else if (clz_tp.isInstanceOf(tpANode));
		//else if (clz_tp.isInstanceOf(tpINode));
		//else if (clz_tp.isInstanceOf(env.tenv.tpEnum));
		//else
		//	Kiev.reportWarning(f, "Strange attribute type "+clz_tp);
		String sname = ("NodeAttr_"+f.sname).intern();
		foreach (TypeDecl td; snode.members; td.sname == sname) {
			if (!f.isInterfaceOnly())
				td.reportWarning().log("Class "+snode+"."+sname+" already exists and will not be generated");
			return td.getType();
		}
		Struct s = this.env.newStruct(sname,snode,ACC_FINAL|ACC_STATIC|ACC_SYNTHETIC,new JavaClass(),null);
		if (!s.isAttached())
			snode.members.add(s);
		{
			String nameTreePkg = nameANode.substring(0,nameANode.lastIndexOf('·'));
			foreach (UserMeta m; f.metas; m.qname().startsWith(nameTreePkg))
				s.setMeta(new Copier(getContext()).copyFull(m));
		}
		Field parent_attr_slot = null;
		if (isAtt) {
			String p = fmatt.getS("parent");
			if (p.length() == 0) {
				parent_attr_slot = tpANode.meta_type.tdecl.resolveField("nodeattr$parent");
			} else {
				int s = p.lastIndexOf('.');
				if (s < 0)
					parent_attr_slot = snode.resolveField(p.intern());
				else
					parent_attr_slot = ((TypeDecl)env.resolveGlobalDNode(p.substring(0,s),getContext())).resolveField(p.substring(s+1).intern());
			}
		}
		if (isSet) {
			TVarBld set = new TVarBld();
			set.append(tpExtSpaceAttrSlot.getStruct().args[0].getAType(), clz_tp);
			s.super_types.insert(0, new TypeRef(tpExtSpaceAttrSlot.applay(set)));
		}
		else if (isArr) {
			TVarBld set = new TVarBld();
			set.append(tpSpaceAttrSlot.getStruct().args[0].getAType(), clz_tp);
			s.super_types.insert(0, new TypeRef(tpSpaceAttrSlot.applay(set)));
		}
		else {
			if (isExtData)
				s.super_types.insert(0, new TypeRef(tpExtAttrSlot));
			else
				s.super_types.insert(0, new TypeRef(tpScalarAttrSlot));
		}
		StdTypes tenv = this.env.getTypeEnv();
		// make constructor
		{
			Constructor ctor = new Constructor(getContext(), 0);
			s.members.add(ctor);
			Constructor sctor = (Constructor)s.super_types[0].getStruct().resolveMethod(null,tenv.tpVoid,tenv.tpString,tpParentAttrSlot,tenv.tpTypeInfo);
			ENode parent_fld_expr = (parent_attr_slot == null ? new ConstNullExpr() : new SFldExpr(0,parent_attr_slot));
			CtorCallExpr ce = new CtorCallExpr(f.pos,
					new SuperExpr(),
					new ENode[]{
						new ConstStringExpr(f.sname),
						parent_fld_expr,
						new TypeInfoExpr(0, new TypeRef(clz_tp))
					}
				);
			ce.symbol = sctor.symbol;
			ctor.body = new Block(0);
			ctor.block.stats.add(new ExprStat(ce));
		}
		if (!isExtData) {
			if (isArr) {
				// add public N[] get(ASTNode parent)
				{
					Method getArr = new MethodImpl(getContext(),"getArray",new ArrayType(tpINode),ACC_PUBLIC | ACC_SYNTHETIC);
					getArr.params.add(new LVar(0, "parent", tpINode, Var.VAR_LOCAL, ACC_FINAL));
					s.addMethod(getArr);
					getArr.body = new Block(0);
					ENode val = new IFldExpr(f.pos, new CastExpr(f.pos, snode.getType(), new LVarExpr(0, getArr.params[0]) ), f);
					getArr.block.stats.add(new ReturnStat(f.pos,val));
				}
				// add public void set(ASTNode parent, N[]:Object narr)
				{
					Method setArr = new MethodImpl(getContext(),"setArray",tenv.tpVoid,ACC_PUBLIC | ACC_SYNTHETIC);
					setArr.params.add(new LVar(0, "parent", tpINode, Var.VAR_LOCAL, ACC_FINAL));
					setArr.params.add(new LVar(0, "narr", tenv.tpObject /*new ArrayType(tpINode)*/, Var.VAR_LOCAL, ACC_FINAL));
					s.addMethod(setArr);
					setArr.body = new Block(0);
					ENode lval = new IFldExpr(f.pos, new CastExpr(f.pos, snode.getType(), new LVarExpr(0, setArr.params[0]) ), f);
					setArr.block.stats.add(new ExprStat(
						new AssignExpr(f.pos,lval,new CastExpr(f.pos, f.getType(), new LVarExpr(0, setArr.params[1])))
					));
				}
			} else {
				// add public N[] get(ASTNode parent)
				{
					Method getVal = new MethodImpl(getContext(),"get",tenv.tpObject,ACC_PUBLIC | ACC_SYNTHETIC);
					getVal.params.add(new LVar(0, "parent", tpINode, Var.VAR_LOCAL, ACC_FINAL));
					s.addMethod(getVal);
					Block block = new Block(0);
					getVal.body = block;
					ENode val = new IFldExpr(f.pos, new CastExpr(f.pos, snode.getType(), new LVarExpr(0, getVal.params[0]) ), f);
					ReturnStat rs = new ReturnStat(f.pos,val);
					block.stats.add(rs);
					if!(val.getType().isReference())
						CastExpr.autoCastToReference(val, rs, ReturnStat.nodeattr$expr);
				}
				// add public void set(ASTNode parent, Object narr)
				{
					Method setVal = new MethodImpl(getContext(),"set",tenv.tpVoid,ACC_PUBLIC | ACC_SYNTHETIC);
					setVal.params.add(new LVar(0, "parent", tpINode, Var.VAR_LOCAL, ACC_FINAL));
					setVal.params.add(new LVar(0, "val", tenv.tpObject, Var.VAR_LOCAL, ACC_FINAL));
					s.addMethod(setVal);
					setVal.body = new Block(0);
					if (!f.isFinal() && MetaAccess.writeable(f)) {
						ENode lval = new IFldExpr(f.pos, new CastExpr(f.pos, snode.getType(), new LVarExpr(0, setVal.params[0]) ), f);
						ENode val = new LVarExpr(0, setVal.params[1]);
						Type ftp = f.getType();
						if (ftp.isReference())
							val = new CastExpr(0,ftp,val);
						else if (ftp ≡ tenv.tpBoolean)
							val = new CastExpr(0,((CoreType)ftp).getRefTypeForPrimitive(),val);
						else if (ftp ≡ tenv.tpChar)
							val = new CastExpr(0,((CoreType)ftp).getRefTypeForPrimitive(),val);
						else
							val = new CastExpr(0,tenv.tpNumberRef,val);
						AssignExpr ae = new AssignExpr(f.pos,lval,val);
						setVal.block.stats.add(new ExprStat(ae));
						if!(ftp.isReference())
							CastExpr.autoCastToPrimitive(val, (CoreType)ftp, ae, AssignExpr.nodeattr$value);
					} else {
						ConstStringExpr msg = new ConstStringExpr((isAtt ? "@nodeAttr " : "@nodeData ")+f.sname+" is not writeable");
						setVal.block.stats.add(
							new ThrowStat(0,new NewExpr(0,tenv.tpRuntimeException,new ENode[]{msg}))
						);
					}
				}
				// add public boolean isWrittable()
				if (f.isFinal() || !MetaAccess.writeable(f)) {
					Method isWrittable = new MethodImpl(getContext(),"isWrittable",tenv.tpBoolean,ACC_PUBLIC | ACC_SYNTHETIC);
					s.addMethod(isWrittable);
					isWrittable.body = new Block(0);
					isWrittable.block.stats.add(new ReturnStat(f.pos,new ConstBoolExpr(false)));
				}
			}
		}

		env.runProcessorsOn(s);
		return s.getType();
	}

	private void makeNodeDecl(SymadeNode sn) {
		if (sn.node_decl != null)
			return;

		StdTypes tenv = this.env.getTypeEnv();
		NodeDecl nd = new NodeDecl();
		sn.node_decl = nd;

		foreach (TypeRef st; sn.super_types; st.getTypeDecl() instanceof SymadeNode) {
			SymadeNode supsn = (SymadeNode)st.getTypeDecl();
			makeNodeDecl(supsn);
			NodeDecl⇑ snd = (NodeDecl⇑)new SymbolRef<NodeDecl>(supsn.node_decl);
			snd.qualified = true;
			nd.super_decls += snd;
		}
		foreach (Field f; sn.members; !f.isStatic() && (f.getMeta(mnAtt) != null || f.getMeta(mnRef) != null)) {
			boolean isAtt = (f.getMeta(mnAtt) != null);
			boolean isArr = f.getType().isInstanceOf(tpNodeSpace);
			boolean isSet = f.getType().isInstanceOf(tpNodeExtSpace);
			NodeAttribute na = new NodeAttribute();
			na.sname = f.sname;
			if (!isAtt)
				na.is_data = true;
			Type ft = f.getType();
			if (isArr)
				na.attr_kind = NodeAttrKind.SPACE_OF_NODES;
			else if (isSet)
				na.attr_kind = NodeAttrKind.EXT_SPACE_OF_NODES;
			else if (ft ≡ tenv.tpBoolean)
				na.attr_kind = NodeAttrKind.SCALAR_BOOL;
			else if (ft ≡ tenv.tpChar)
				na.attr_kind = NodeAttrKind.SCALAR_CHAR;
			else if (ft ≡ tenv.tpByte)
				na.attr_kind = NodeAttrKind.SCALAR_BYTE;
			else if (ft ≡ tenv.tpShort)
				na.attr_kind = NodeAttrKind.SCALAR_SHORT;
			else if (ft ≡ tenv.tpInt)
				na.attr_kind = NodeAttrKind.SCALAR_INT;
			else if (ft ≡ tenv.tpLong)
				na.attr_kind = NodeAttrKind.SCALAR_LONG;
			else if (ft ≡ tenv.tpFloat)
				na.attr_kind = NodeAttrKind.SCALAR_FLOAT;
			else if (ft ≡ tenv.tpDouble)
				na.attr_kind = NodeAttrKind.SCALAR_DOUBLE;
			else if (ft.meta_type.tdecl.isEnum())
				na.attr_kind = NodeAttrKind.SCALAR_ENUM;
			else if (ft ≈ tenv.tpString)
				na.attr_kind = NodeAttrKind.SCALAR_STRING;
			else if (ft.meta_type.tdecl instanceof SymadeNode)
				na.attr_kind = NodeAttrKind.SCALAR_NODE;
			else
				na.attr_kind = NodeAttrKind.SCALAR_OBJ;
			nd.attrs += na;
		}
	}

	public void process(ANode node, Transaction tr) {
		if (node instanceof CompilationUnit) {
			CompilationUnit cu = (CompilationUnit)node;
			WorkerThreadGroup wthg = (WorkerThreadGroup)Thread.currentThread().getThreadGroup();
			if (wthg.setProcessorRun(cu,this))
				return;
			if (utils == null)
				utils = new VNodeUtils(getContext());
			processed = null;
			tr = Transaction.enter(tr,"VNodeFE_GenMembers");
			try {
				doProcess(node);
			} finally { tr.leave(); }
			processed = null;
		}
	}

	public void doProcess(ANode:ANode node) {
		return;
	}

	public void doProcess(SyntaxScope:ANode ss) {
		foreach (ANode dn; ss.members)
			this.doProcess(dn);
	}

	private void doProcess(Struct:ANode s) {
		if (processed == null)
			processed = new Vector<Struct>();
		processed.append(s);
		foreach (Struct dn; s.members)
			this.doProcess(dn);
		if (s instanceof SymadeNode) {
			SymadeNode sn = (SymadeNode)s;
			if (sn.node_decl == null)
				makeNodeDecl(sn);
		}
		if (VNodeUtils.isNodeImpl(s))
			generateNodeValues(s)
		return;
	}

	private void generateNodeValues(Struct s) {
		if (s.isInterface() && !s.isMixin())
			return;
		foreach (Field f; s.members; f.sname == nameEnumValuesFld)
			return; // already generated

		Vector<Struct> sup_struct = new Vector<Struct>();
		foreach (TypeRef st; s.super_types; VNodeUtils.isNodeKind(st.getStruct())) {
			Struct sups = st.getStruct();
			this.doProcess(sups);
			sup_struct.append(sups);
		}
		// attribute names array
		Vector<Field> aflds = new Vector<Field>();
		Vector<Field> dnaflds = new Vector<Field>();
		foreach (Field f; s.members; !f.isStatic() && (f.getMeta(mnAtt) != null || f.getMeta(mnRef) != null))
			aflds.append(f);
		foreach (Field f; aflds) {
			boolean isAtt = (f.getMeta(mnAtt) != null);
			boolean isArr = f.getType().isInstanceOf(tpNodeSpace);
			boolean isSet = f.getType().isInstanceOf(tpNodeExtSpace);
			Type tpa = makeNodeAttrClass(s,f);
			String fname = ("nodeattr$"+f.sname).intern();
			Field f_attr = null;
			foreach (Field ff; s.members; ff.sname == fname) {
				f_attr = ff;
				break;
			}
			if (f_attr != null) {
				if (!f.isInterfaceOnly())
					f_attr.reportWarning().log("Field "+s+"."+fname+" already exists and will not be generated");
				dnaflds.append(f_attr);
			} else {
				Field dnaf = new Field(fname, tpa, ACC_PUBLIC|ACC_STATIC|ACC_FINAL|ACC_SYNTHETIC);
				s.addField(dnaf);
				dnaflds.append(dnaf);
				f.nodeattr_of_attr = new SymbolRef<Field>(dnaf);
			}
			if (isAtt && !isArr && !isSet)
				f.setVirtual(true);
			UserMeta fmeta = (UserMeta) (isAtt ? f.getMeta(mnAtt) : f.getMeta(mnRef));
			if (fmeta.getZ(nameExtData) && !isSet) {
				f.setVirtual(true);
				f.setAbstract(true);
			}
		}
		s.addField(new Field(nameEnumValuesFld, new ArrayType(tpAttrSlot), ACC_PRIVATE|ACC_STATIC|ACC_FINAL|ACC_SYNTHETIC));

		// node type info
		ENode node_defined_slots;
		{
			ENode[] vals_init = new ENode[dnaflds.size()];
			for(int i=0; i < vals_init.length; i++) {
				Field dnaf = dnaflds[i];
				vals_init[i] = new SFldExpr(dnaf.pos, dnaf);
			}
			node_defined_slots = new NewInitializedArrayExpr(0, new TypeExpr(tpAttrSlot,Operator.PostTypeArray,new ArrayType(tpAttrSlot)), vals_init)
		}


		Field fld_nti = new Field("$node_type_info", tpNodeTypeInfo, ACC_PRIVATE|ACC_STATIC|ACC_FINAL|ACC_SYNTHETIC);
		fld_nti.init = new NewExpr(0, tpNodeTypeInfo, new ENode[]{
			new TypeClassExpr(0, new TypeRef(s.getType())),
			node_defined_slots
		});
		s.addField(fld_nti);
	}
}

//////////////////////////////////////////////////////
//   Generate class members (enumerate sub-nodes)   //
//////////////////////////////////////////////////////

public final class VNodeFE_GenDispatch extends TransfProcessor {
	public VNodeFE_GenDispatch(Env env, int id) { super(env,id,KievExt.VNode); }
	public String getDescr() { "VNode dispatch generation" }

	@forward
	private VNodeUtils utils;
	private Vector<Struct> processed;

	public void process(ANode node, Transaction tr) {
		if (node instanceof CompilationUnit) {
			CompilationUnit cu = (CompilationUnit)node;
			WorkerThreadGroup wthg = (WorkerThreadGroup)Thread.currentThread().getThreadGroup();
			if (wthg.setProcessorRun(cu,this))
				return;
			if (utils == null)
				utils = new VNodeUtils(getContext());
			processed = null;
			tr = Transaction.enter(tr,"VNodeFE_GenDispatch");
			try {
				doProcess(node);
			} finally { tr.leave(); }
			processed = null;
		}
	}

	public void doProcess(ANode:ANode node) {
		return;
	}

	public void doProcess(SyntaxScope:ANode ss) {
		foreach (ANode dn; ss.members)
			this.doProcess(dn);
	}

	private void doProcess(Struct:ANode s) {
		if (processed == null)
			processed = new Vector<Struct>();
		processed.append(s);
		foreach (Struct dn; s.members)
			this.doProcess(dn);
		if (VNodeUtils.isLanguageImpl(s)) {
			generateLangDispatcherI(s);
			generateLangDispatcherC(s);
		}
		return;
	}

	private Vector<Struct> getSuperLanguages(Struct slang) {
		Vector<Struct> out = new Vector<Struct>();
		Field superLanguages = slang.resolveField("superLanguages", false);
		if (superLanguages == null)
			return out;
		if!(superLanguages.init instanceof NewInitializedArrayExpr)
			return out;
		NewInitializedArrayExpr init = (NewInitializedArrayExpr)superLanguages.init;
		foreach (TypeClassExpr tce; init.args) {
			out.append(tce.ttype.getStruct());
		}
		return out;
	}

	private Vector<Struct> getLanguagesNodes(Struct slang) {
		Vector<Struct> out = new Vector<Struct>();
		Field nodesField = slang.resolveField("nodeClasses", false);
		if (nodesField == null)
			return out;
		if!(nodesField.init instanceof NewInitializedArrayExpr)
			return out;
		NewInitializedArrayExpr init = (NewInitializedArrayExpr)nodesField.init;
		foreach (TypeClassExpr tce; init.args) {
			out.append(tce.ttype.getStruct());
		}
		return out;
	}

	private Method getMethod(Struct s, String name, boolean iface) {
		s = s.checkResolved();
		foreach (Method m; s.members; m.hasName(name)) return m;
		foreach (TypeRef st; s.super_types) {
			Struct sups = st.getStruct();
			if (!iface && sups.isInterface())
				continue;
			Method m = getMethod(sups, name, iface);
			if (m != null)
				return m;
		}
		return null;
	}

	private Struct generateLangDispatcherI(Struct slang) {
		Struct i_dispatcher = null;
		foreach (Struct s; slang.members) {
			if (s.sname == "DispatcherI") {
				i_dispatcher = s;
				break;
			}
		}
		if (i_dispatcher != null && i_dispatcher.is_struct_node_generated)
			return i_dispatcher;
		if (i_dispatcher == null) {
			if (slang.isInterfaceOnly()) {
				slang.reportError().log("DispatcherI for language class "+slang+" not found");
				return null;
			}
			i_dispatcher = this.env.newStruct("DispatcherI",slang,ACC_PUBLIC|ACC_STATIC|ACC_INTERFACE/*|ACC_SYNTHETIC*/,new JavaClass(),null);
			if (!i_dispatcher.isAttached())
				slang.members += i_dispatcher;
			Struct disp_base = (Struct)this.env.resolveGlobalDNode(VNodeUtils.nameLanguageDispatcherI, getContext());
			i_dispatcher.super_types += new TypeRef(disp_base.getType());
			foreach (Struct sl; getSuperLanguages(slang)) {
				disp_base = generateLangDispatcherI(sl.getStruct());
				i_dispatcher.super_types += new TypeRef(disp_base.getType());
			}
		}
		i_dispatcher.is_struct_node_generated = true;

		StdTypes tenv = this.env.getTypeEnv();
		// generate methods
		foreach (Struct s_node; getLanguagesNodes(slang)) {
			if (s_node.isInterface())
				continue;
			// Object applyToNodeName(NodeType node, Object arg)
			String applyToNodeName = ("applyTo"+s_node.sname).intern();
			Method applyTo = getMethod(i_dispatcher, applyToNodeName, true);
			if (applyTo != null) {
				env.reportInfo().at(s_node).log("Method "+i_dispatcher+"."+applyToNodeName+" already exists, dispatcher method is not generated");
			} else {
				applyTo = new MethodImpl(getContext(), applyToNodeName, tenv.tpObject, ACC_PUBLIC|ACC_ABSTRACT /*| ACC_SYNTHETIC*/);
				applyTo.params.append(new LVar(0,"node", s_node.getType(), Var.VAR_LOCAL, 0));
				applyTo.params.append(new LVar(0,"arg", tenv.tpObject, Var.VAR_LOCAL, 0));
				i_dispatcher.addMethod(applyTo);
			}
		}
		return i_dispatcher;
	}

	private Struct generateLangDispatcherC(Struct slang) {
		Struct c_dispatcher = null;
		foreach (Struct s; slang.members) {
			if (s.sname == "DispatcherC") {
				c_dispatcher = s;
				break;
			}
		}
		if (c_dispatcher != null && c_dispatcher.is_struct_node_generated)
			return c_dispatcher;
		if (c_dispatcher == null) {
			if (slang.isInterfaceOnly()) {
				slang.reportError().log("DispatcherC for language class "+slang+" not found");
				return null;
			}
			c_dispatcher = this.env.newStruct("DispatcherC",slang,ACC_PUBLIC|ACC_STATIC/*|ACC_SYNTHETIC*/,new JavaClass(),null);
			if (!c_dispatcher.isAttached())
				slang.members += c_dispatcher;
			Struct disp_base = (Struct)this.env.resolveGlobalDNode(VNodeUtils.nameLanguageDispatcherC, getContext());
			c_dispatcher.super_types += new TypeRef(disp_base.getType());
			Struct i_dispatcher = generateLangDispatcherI(slang);
			if (i_dispatcher != null)
				c_dispatcher.super_types += new TypeRef(i_dispatcher.getType());
		} else {
			foreach (TypeRef st; c_dispatcher.super_types) {
				Struct sups = st.getStruct();
				if (sups.sname == "DispatcherC" || sups.sname == "DispatcherI") {
					ANode p = sups.parent;
					if (p instanceof Struct && p != slang && VNodeUtils.isLanguageImpl((Struct)p)) {
						generateLangDispatcherI((Struct)p);
						generateLangDispatcherC((Struct)p);
					}
				}
			}
		}
		c_dispatcher.is_struct_node_generated = true;

		StdTypes tenv = this.env.getTypeEnv();
		// generate methods
		foreach (Struct s_node; getLanguagesNodes(slang)) {
			if (s_node.isInterface())
				continue;
			// public Object applyToNodeName(NodeType node, Object arg) { return this.applyToSuperName(node, arg); }
			String applyToNodeName = ("applyTo"+s_node.sname).intern();
			Method applyTo = getMethod(c_dispatcher, applyToNodeName, false);
			if (applyTo != null) {
				env.reportInfo().at(s_node).log("Method "+c_dispatcher+"."+applyToNodeName+" already exists, dispatcher method is not generated");
			} else {
				applyTo = new MethodImpl(getContext(), applyToNodeName, tenv.tpObject, ACC_PUBLIC /*| ACC_SYNTHETIC*/);
				applyTo.params.append(new LVar(0,"node", s_node.getType(), Var.VAR_LOCAL, 0));
				applyTo.params.append(new LVar(0,"arg", tenv.tpObject, Var.VAR_LOCAL, 0));
				c_dispatcher.addMethod(applyTo);
			}
		}
		// generate bodies
		foreach (Method applyTo; c_dispatcher.members) {
			if (applyTo.sname == null || !applyTo.sname.startsWith("applyTo") || applyTo.body != null)
				continue;
			Struct s_node = applyTo.params[0].getType().getStruct();
			String applyToSuperName = "applyToANode";
			foreach (TypeRef st; s_node.super_types; isNodeImpl(st.getStruct())) {
				Struct sup = st.getStruct();
				applyToSuperName = ("applyTo"+sup.sname).intern();
			}
			Method applyToSuper = getMethod(c_dispatcher, applyToSuperName, false);
			if (applyToSuper == null) {
				c_dispatcher.reportWarning().log("Dispatcher method "+c_dispatcher+"."+applyToSuperName+"(...) is not found for method "+applyTo);
				//throw new CompilerException(s,"Dispatcher method "+s_dispatcher+"."+applyToSuperName+"(...) is not found");
				applyToSuper = getMethod(c_dispatcher, "applyToANode", false);
			}
			applyTo.setAbstract(false);
			applyTo.body = new Block(0);
			applyTo.block.stats.add(new ReturnStat(0,
					new CallExpr(0,new ThisExpr(0), applyToSuper,
							new ENode[]{new LVarExpr(0,applyTo.params[0]), new LVarExpr(0,applyTo.params[1])})));
			env.runProcessorsOn(applyTo.body);
		}
		return c_dispatcher;
	}
}

////////////////////////////////////////////////////
//	   PASS - verification                        //
////////////////////////////////////////////////////

public final class VNodeFE_Verify extends VerifyProcessor {

	@forward
	private VNodeUtils utils;

	private Hashtable<String,LangDecl> allLangs = new Hashtable<String,LangDecl>();
	private Hashtable<String,NodeDecl> allNodeDecls = new Hashtable<String,NodeDecl>();

	public VNodeFE_Verify(Env env, int id) { super(env,id,KievExt.VNode); }

	public String getDescr() { "VNode verification" }

	private LangDecl getLangDecl(TypeDecl s) {
		LangDecl ld = allLangs.get(s.qname());
		if (ld != null)
			return ld;
		ld = new LangDecl();
		ld.sname = "lang"+s.sname;
		allLangs.put(s.qname(), ld);
		return ld;
	}

	private NodeDecl getNodeDecl(TypeDecl s) {
		NodeDecl nd = allNodeDecls.get(s.qname());
		if (nd != null)
			return nd;
		nd = new NodeDecl();
		nd.sname = s.sname;
		allNodeDecls.put(s.qname(), nd);
		return nd;
	}

	public void process(ANode node, Transaction tr) {
		if (node instanceof CompilationUnit) {
			CompilationUnit cu = (CompilationUnit)node;
			WorkerThreadGroup wthg = (WorkerThreadGroup)Thread.currentThread().getThreadGroup();
			if (wthg.setProcessorRun(cu,this))
				return;
			if (utils == null)
				utils = new VNodeUtils(getContext());
			if (node instanceof Struct && VNodeUtils.isNodeKind((Struct)node)) {
				tr = Transaction.enter(tr,"VNodeFE_Verify");
				try {
					verifyNodeStruct((Struct)node);
				} finally { tr.leave(); }
			}
			/*
			if (node instanceof Struct && !node.isInterface() && node.getType().isInstanceOf(tpLanguageIface)) {
				LangDecl ld = getLangDecl((Struct)node);
				if (!ld.isAttached()) {
					((KievPackage)node.parent()).pkg_members += ld;
					FileUnit fu = FileUnit.makeFile("lang"+node.sname, env.getProject(), false);
					fu.members += ld;
				}
				foreach (TypeRef tr; node.super_types; tr.getType().isInstanceOf(tpLanguageIface)) {
					ld.super_langs += (LangDecl⇑)new SymbolRef<LangDecl>(getLangDecl(tr.getStruct()));
				}
			}
			*/
		}
	}

	private void verifyLangStruct(Struct s) {

	}
	private void verifyNodeStruct(Struct s) {
		UserMeta m = (UserMeta)s.getMeta(mnNode);
		MetaValueScalar langValue = (MetaValueScalar)m.get(nameLangName);
		TypeDecl td;
		if (langValue.value instanceof TypeClassExpr)
			td = ((TypeClassExpr)langValue.value).ttype.getTypeDecl();
		else
			td = ((TypeRef)langValue.value).getTypeDecl();
		if (td.getType() ≡ this.env.getTypeEnv().tpVoid)
			return;
		if!(td instanceof Struct) {
			m.reportError().log("Language '{}' is not a class", td);
			return;
		}
		if (td.isInterfaceOnly())
			return;
		Field nodeClasses = td.resolveField("nodeClasses", false);
		if (nodeClasses == null) {
			m.reportWarning().log("Language '"+td+"' has no field 'nodeClasses'");
			return;
		}
		if!(nodeClasses.init instanceof NewInitializedArrayExpr) {
			m.reportWarning().log("Language '{}' has field 'nodeClasses' with wrong initializer (NewInitializedArrayExpr expected)", td);
			return;
		}
		NewInitializedArrayExpr init = (NewInitializedArrayExpr)nodeClasses.init;
		boolean found = false;
		foreach (TypeClassExpr tce; init.args) {
			if (tce.ttype.getStruct() == s) {
				found = true;
				break;
			}
		}
		if (!found) {
			m.reportWarning().log("Language '{}' has no reference to @node '{}' in field 'nodeClasses'", td, s);
			return;
		}
		/*
		LangDecl ld = getLangDecl(td);
		NodeDecl nd = getNodeDecl(s);
		if (nd.isAttached())
			return;
		String ndname = m.getS("name");
		if (ndname == null || ndname.length() == 0)
			ndname = s.sname;
		nd.sname = ndname;
		ld.decls += nd;
		foreach (TypeRef tr; s.super_types; VNodeUtils.isNodeKind(tr.getType()))
			nd.super_decls += (NodeDecl⇑)new SymbolRef<NodeDecl>(getNodeDecl(tr.getStruct()));
		foreach (Field f; s.members) {
			UserMeta fmatt = (UserMeta)f.getMeta(mnAtt);
			UserMeta fmref = (UserMeta)f.getMeta(mnRef);
			if (fmatt != null || fmref != null) {
				NodeAttribute na = new NodeAttribute();
				na.sname = f.sname;
				if (fmref != null)
					na.is_data = true;
				Type ft = f.getType();
				if (ft ≈ tenv.tpBoolean)
					na.attr_kind = NodeAttrKind.SCALAR_BOOL;
				else if (ft ≈ tenv.tpString)
					na.attr_kind = NodeAttrKind.SCALAR_STRING;
				else if (ft ≈ tenv.tpInt)
					na.attr_kind = NodeAttrKind.SCALAR_INT;
				else if (ft.isInstanceOf(tpNodeExtSpace))
					na.attr_kind = NodeAttrKind.SPACE;
				else if (ft.isInstanceOf(tpNodeExtSpace))
					na.attr_kind = NodeAttrKind.EXT_SPACE;
				else if (ft.isInstanceOf(tpNodeExtSpace))
					na.attr_kind = NodeAttrKind.EXT_SPACE;
				else if (VNodeUtils.isNodeKind(ft))
					na.attr_kind = NodeAttrKind.SCALAR_NODE;
				else
					na.attr_kind = NodeAttrKind.SCALAR_OBJ;
				nd.attrs += na;
			}
		}
		*/
	}

}

public final class VNodeME_PreGenerate extends BackendProcessor {

	@forward
	private VNodeUtils utils;
	private Method _codeSet;
	private Method _codeGet;

	public VNodeME_PreGenerate(Env env, int id) { super(env,id,KievBackend.Java15); }
	public String getDescr() { "VNode pre-generation" }

	////////////////////////////////////////////////////
	//	   PASS - preGenerate                         //
	////////////////////////////////////////////////////

	public void process(ANode node, Transaction tr) {
		if (node instanceof CompilationUnit) {
			CompilationUnit cu = (CompilationUnit)node;
			WorkerThreadGroup wthg = (WorkerThreadGroup)Thread.currentThread().getThreadGroup();
			if (wthg.setProcessorRun(cu,this))
				return;
			tr = Transaction.enter(tr,"VNodeME_PreGenerate");
			try {
				doProcess(node);
			} finally { tr.leave(); }
		}
	}

	public void doProcess(ANode:ANode node) {
		return;
	}

	public void doProcess(SyntaxScope:ANode ss) {
		foreach (ANode dn; ss.members)
			this.doProcess(dn);
	}

	final Struct getIFaceOfImpl(Struct impl) {
		if (impl.parent() instanceof Struct) {
			Struct iface = (Struct)impl.parent();
			if (iface.isInterface() && impl.isClazz() && iface.iface_impl == impl)
				return iface;
		}
		return null;
	}

	final boolean isNodeKind(Struct s) {
		return isNodeIface(s) || isNodeImpl(s);
	}

	final boolean isNodeImpl(Struct s) {
		if (s.isClazz() && s.getMeta(mnNode) != null)
			return true;
		Struct iface = getIFaceOfImpl(s);
		if (iface != null && iface.getMeta(mnNode) != null)
			return true;
		return false;
	}

	final boolean isNodeIface(Struct s) {
		if (s.isInterface() && s.getMeta(mnNode) != null)
			return true;
		return false;
	}

	final boolean isLangImpl(Struct s) {
		if (s.isClazz() && s.getMeta(mnLanguage) != null)
			return true;
		return false;
	}

	public Method getCodeSet() {
		if (_codeSet == null) {
			TypeDecl td = (TypeDecl)this.env.loadTypeDecl("kiev·transf·TemplateVNode", true, getContext());
			_codeSet = td.resolveMethod("codeSet", this.env.getTypeEnv().tpVoid)
		}
		return _codeSet;
	}

	public Method getCodeGet() {
		if (_codeGet == null) {
			TypeDecl td = (TypeDecl)this.env.loadTypeDecl("kiev·transf·TemplateVNode", true, getContext());
			_codeGet = td.resolveMethod("codeGet", this.env.getTypeEnv().tpVoid)
		}
		return _codeGet;
	}

	public void doProcess(Struct:ANode s) {
		if (s.isInterfaceOnly())
			return;
		if (s.isInterface() && !s.isMixin() || !isNodeImpl(s)) {
			foreach(Struct sub; s.members)
				doProcess(sub);
			return;
		}

		if (utils == null)
			utils = new VNodeUtils(getContext());

		Struct iface = getIFaceOfImpl(s);
		if (iface == null)
			iface = s;
		Struct impl;
		if (s.isClazz())
			impl = s;
		else
			impl = s.iface_impl;

		foreach (TypeRef st; iface.super_types; isNodeKind(st.getStruct()))
			this.doProcess(st.getStruct());

		// attribute names array
		Vector<Field> aflds = null;
		// auto-generated $values field
		Field vals = null;
		if (!s.isInterfaceOnly()) {
			foreach (Field f; iface.members; f.sname == nameEnumValuesFld) {
				vals = f;
				break;
			}
			if (vals == null)
				throw new CompilerException(s,"Auto-generated field with name "+nameEnumValuesFld+" is not found");
			if (vals.init != null || nameNode.equals(iface.qname()) || nameANode.equals(iface.qname()))
				return; // already generated

			aflds = new Vector<Field>();
			collectAllAttrFields(aflds, iface);
			ENode[] vals_init = new ENode[aflds.size()];
			for(int i=0; i < vals_init.length; i++) {
				Field f = aflds[i];
				boolean isAtt = (f.getMeta(mnAtt) != null);
				boolean isArr = f.getType().isInstanceOf(tpNodeSpace);
				boolean isSet = f.getType().isInstanceOf(tpNodeExtSpace);
				if (Env.ctxTDecl(f) != iface) {
					vals_init[i] = new SFldExpr(f.pos, iface.resolveField(("nodeattr$"+f.sname).intern(), true));
					continue;
				}
				Field nodeattr_f = getField(iface,("nodeattr$"+f.sname).intern());
				ENode e = new NewExpr(0, nodeattr_f.getType(), ENode.emptyArray);
				nodeattr_f.init = e;
				env.runProcessorsOn(e);
				vals_init[i] = new SFldExpr(nodeattr_f.pos, nodeattr_f);
			}
			vals.init = new NewInitializedArrayExpr(0, new TypeExpr(tpAttrSlot,Operator.PostTypeArray,new ArrayType(tpAttrSlot)), vals_init);
			env.runProcessorsOn(vals.init);
		}

		// AttrSlot[] values() { return $values; }
		if (hasMethod(iface, nameEnumValues)) {
			if (!s.isInterfaceOnly())
				iface.reportWarning().log("Method "+iface+"."+nameEnumValues+" already exists, @node member is not generated");
		} else {
			Method elems = new MethodImpl(getContext(),nameEnumValues,new ArrayType(tpAttrSlot),ACC_PUBLIC | ACC_SYNTHETIC);
			iface.addMethod(elems);
			if (!s.isInterfaceOnly()) {
				elems.body = new Block(0);
				elems.block.stats.add(
					new ReturnStat(0,
						new SFldExpr(0,vals) ) );
				env.runProcessorsOn(elems);
			}
		}

		// NodeTypeInfo getNodeTypeInfo() { return $node_type_info; }
		Field fld_node_type_info = null;
		foreach (Field f; iface.members; f.sname == "$node_type_info") {
			fld_node_type_info = f;
			break;
		}
		if (fld_node_type_info == null)
			throw new CompilerException(s,"Auto-generated field with name "+"$node_type_info"+" is not found");
		if (hasMethod(iface, "getNodeTypeInfo")) {
			if (!s.isInterfaceOnly())
				iface.reportWarning().log("Method "+iface+"."+"getNodeTypeInfo"+" already exists, @node member is not generated");
		} else {
			Method mnti = new MethodImpl(getContext(),"getNodeTypeInfo",tpNodeTypeInfo,ACC_PUBLIC | ACC_SYNTHETIC);
			iface.addMethod(mnti);
			if (!s.isInterfaceOnly()) {
				mnti.body = new Block(0);
				mnti.block.stats.add(
					new ReturnStat(0,
						new SFldExpr(0,fld_node_type_info) ) );
				env.runProcessorsOn(mnti);
			}
		}

		StdTypes tenv = this.env.getTypeEnv();

		// Language getCompilerLang()
		Struct s_language = null;
		if (!iface.getType().isInstanceOf(tpNode) || hasMethod(impl, "getCompilerLang")) {
			//if (!s.isInterfaceOnly())
			//	Kiev.reportWarning(s,"Method "+s+"."+"getCompilerLang already exists, @node member is not generated");
		} else {
			Method lng = new MethodImpl(getContext(),"getCompilerLang",tpLanguageIface,ACC_PUBLIC | ACC_SYNTHETIC);
			impl.addMethod(lng);
			if (!s.isInterfaceOnly()) {
				lng.body = new Block();
				UserMeta m = (UserMeta)iface.getMeta(mnNode);
				MetaValueScalar langValue = (MetaValueScalar)m.get(nameLangName);
				TypeDecl td;
				if (langValue.value instanceof TypeClassExpr)
					td = ((TypeClassExpr)langValue.value).ttype.getTypeDecl();
				else
					td = ((TypeRef)langValue.value).getTypeDecl();
				ENode res = null;
				if (td.getType() ≡ tenv.tpVoid)
					res = new ConstNullExpr();
				else if (!td.isSingleton())
					res = new ConstNullExpr();
				else {
					s_language = td.getStruct();
					res = new TypeRef(td.getType());
				}
				lng.block.stats.append(new ReturnStat(0,res));
				env.runProcessorsOn(lng);
			}
		}

		// String getCompilerNodeName()
		String node_name = iface.sname;
		if (!iface.getType().isInstanceOf(tpNode) || hasMethod(impl, "getCompilerNodeName")) {
			//if (!s.isInterfaceOnly())
			//	Kiev.reportWarning(s,"Method "+s+"."+"getCompilerNodeName already exists, @node member is not generated");
		} else {
			Method nname = new MethodImpl(getContext(),"getCompilerNodeName",tenv.tpString,ACC_PUBLIC | ACC_SYNTHETIC);
			impl.addMethod(nname);
			if (!s.isInterfaceOnly()) {
				nname.body = new Block();
				UserMeta m = (UserMeta)iface.getMeta(mnNode);
				String nm = m.getS(nameNodeName);
				if (nm != null && nm.length() > 0)
					node_name = nm;
				nname.block.stats.append(new ReturnStat(0,new ConstStringExpr(node_name)));
				env.runProcessorsOn(nname);
			}
		}

		if (s_language != null) {
			Struct i_dispatcher = null;
			Struct c_dispatcher = null;
			foreach (Struct s; s_language.members) {
				if (s.sname == "DispatcherI")
					i_dispatcher = s;
				if (s.sname == "DispatcherC")
					c_dispatcher = s;
			}
			if (hasMethod(iface, "dispatch")) {
				if (!s.isInterfaceOnly())
					iface.reportWarning().log("Method "+iface+".dispatch() already exists, @node member is not generated");
			} else {
				Method disp;
				Var disp_var;
				Var arg_var;
				// public Object dispatch(MyLanguage.DispatcherC dispatcher, Object arg) {
				//    return dispatcher.applyToNodeName(this, arg);
				// }
				disp = new MethodImpl(getContext(),"dispatch", tenv.tpObject, ACC_PUBLIC /*| ACC_SYNTHETIC*/);
				disp.params.append(disp_var=new LVar(0,"dispatcher", c_dispatcher.getType(), Var.VAR_LOCAL, 0));
				disp.params.append(arg_var=new LVar(0,"arg", tenv.tpObject, Var.VAR_LOCAL, 0));
				iface.addMethod(disp);
				if (!s_language.isInterfaceOnly()) {
					String applyToNodeName = ("applyTo"+iface.sname).intern();
					Method applyTo = getMethod(c_dispatcher, applyToNodeName);
					if (applyTo == null) {
						iface.reportWarning().log("Method "+c_dispatcher+"."+applyToNodeName+"() not found");
					} else {
						disp.body = new Block(0);
						disp.block.stats.add(new ReturnStat(0,
								new CallExpr(0,new LVarExpr(0,disp_var),applyTo,new ENode[]{new ThisExpr(0), new LVarExpr(0,arg_var)})));
						env.runProcessorsOn(disp);
					}
				}
				// public Object dispatch(MyLanguage.DispatcherI dispatcher, Object arg) {
				//    return dispatcher.applyToNodeName(this, arg);
				// }
				disp = new MethodImpl(getContext(),"dispatch", tenv.tpObject, ACC_PUBLIC /*| ACC_SYNTHETIC*/);
				disp.params.append(disp_var=new LVar(0,"dispatcher", i_dispatcher.getType(), Var.VAR_LOCAL, 0));
				disp.params.append(arg_var=new LVar(0,"arg", tenv.tpObject, Var.VAR_LOCAL, 0));
				iface.addMethod(disp);
				if (!s_language.isInterfaceOnly()) {
					String applyToNodeName = ("applyTo"+iface.sname).intern();
					Method applyTo = getMethod(i_dispatcher, applyToNodeName);
					if (applyTo == null) {
						iface.reportWarning().log("Method "+i_dispatcher+"."+applyToNodeName+"() not found");
					} else {
						disp.body = new Block(0);
						disp.block.stats.add(new ReturnStat(0,
								new CallExpr(0,new LVarExpr(0,disp_var),applyTo,new ENode[]{new ThisExpr(0), new LVarExpr(0,arg_var)})));
						env.runProcessorsOn(disp);
					}
				}
				// public Object dispatch(Language.DispatcherC dispatcher, Object arg) {
				//    if (dispatcher instanceof MyLanguage.DispatcherC)
				//        return ((MyLanguage.DispatcherC)dispatcher).applyToNodeName(this, arg);
				//    return super.dispatch(dispatcher, arg);
				// }
				Struct disp_base;
				disp_base = (Struct)this.env.resolveGlobalDNode(VNodeUtils.nameLanguageDispatcherC, getContext());
				disp = new MethodImpl(getContext(),"dispatch", tenv.tpObject, ACC_PUBLIC /*| ACC_SYNTHETIC*/);
				disp.params.append(disp_var=new LVar(0,"dispatcher", disp_base.getType(), Var.VAR_LOCAL, 0));
				disp.params.append(arg_var=new LVar(0,"arg", tenv.tpObject, Var.VAR_LOCAL, 0));
				iface.addMethod(disp);
				if (!s_language.isInterfaceOnly()) {
					String applyToNodeName = ("applyTo"+iface.sname).intern();
					disp.body = new Block(0);
					disp.block.stats.add(new IfElseStat(0,
							new InstanceofExpr(0,new LVarExpr(0,disp_var),c_dispatcher.getType()),
							new ReturnStat(0, new CallExpr(0,
									new CastExpr(0, c_dispatcher.getType(), new LVarExpr(0,disp_var)),
									new SymbolRef<Method>(applyToNodeName),null,
									new ENode[]{new ThisExpr(0), new LVarExpr(0,arg_var)})),
							null
							));
					disp.block.stats.add(new ReturnStat(0,
							new CallExpr(0,new SuperExpr(0), new SymbolRef<Method>("dispatch"), null,
									new ENode[]{new LVarExpr(0,disp_var), new LVarExpr(0,arg_var)}))
							);
					env.runProcessorsOn(disp);
				}
				// public Object dispatch(Language.DispatcherI dispatcher, Object arg) {
				//    if (dispatcher instanceof MyLanguage.DispatcherC)
				//        return ((MyLanguage.DispatcherC)dispatcher).applyToNodeName(this, arg);
				//    if (dispatcher instanceof MyLanguage.DispatcherI)
				//        return ((MyLanguage.DispatcherI)dispatcher).applyToNodeName(this, arg);
				//    return super.dispatch(dispatcher, arg);
				// }
				disp_base = (Struct)this.env.resolveGlobalDNode(VNodeUtils.nameLanguageDispatcherI, getContext());
				disp = new MethodImpl(getContext(),"dispatch", tenv.tpObject, ACC_PUBLIC /*| ACC_SYNTHETIC*/);
				disp.params.append(disp_var=new LVar(0,"dispatcher", disp_base.getType(), Var.VAR_LOCAL, 0));
				disp.params.append(arg_var=new LVar(0,"arg", tenv.tpObject, Var.VAR_LOCAL, 0));
				iface.addMethod(disp);
				if (!s_language.isInterfaceOnly()) {
					String applyToNodeName = ("applyTo"+iface.sname).intern();
					disp.body = new Block(0);
					disp.block.stats.add(new IfElseStat(0,
							new InstanceofExpr(0,new LVarExpr(0,disp_var),c_dispatcher.getType()),
							new ReturnStat(0, new CallExpr(0,
									new CastExpr(0, c_dispatcher.getType(), new LVarExpr(0,disp_var)),
									new SymbolRef<Method>(applyToNodeName),null,
									new ENode[]{new ThisExpr(0), new LVarExpr(0,arg_var)})),
							null
							));
					disp.block.stats.add(new IfElseStat(0,
							new InstanceofExpr(0,new LVarExpr(0,disp_var),i_dispatcher.getType()),
							new ReturnStat(0, new CallExpr(0,
									new CastExpr(0, i_dispatcher.getType(), new LVarExpr(0,disp_var)),
									new SymbolRef<Method>(applyToNodeName),null,
									new ENode[]{new ThisExpr(0), new LVarExpr(0,arg_var)})),
							null
							));
					disp.block.stats.add(new ReturnStat(0,
							new CallExpr(0,new SuperExpr(0), new SymbolRef<Method>("dispatch"), null,
									new ENode[]{new LVarExpr(0,disp_var), new LVarExpr(0,arg_var)}))
							);
					env.runProcessorsOn(disp);
				}
			}
		}

		// copyTo(Object)
		if (iface.getMeta(mnNode) != null && !((UserMeta)iface.getMeta(mnNode)).getZ(nameCopyable)) {
			// node is not copyable
		}
		else if (hasMethod(impl, "copyTo")) {
			if (!s.isInterfaceOnly())
				impl.reportWarning().log("Method "+impl+"."+"copyTo(...) already exists, @node member is not generated");
		} else {
			Method copyV = new MethodImpl(getContext(),"copyTo",tenv.tpObject,ACC_PUBLIC | ACC_SYNTHETIC);
			Var tn;
			Var cc;
			copyV.params.append(tn=new LVar(0,"to$node", tenv.tpObject, Var.VAR_LOCAL, 0));
			copyV.params.append(cc=new LVar(0,"in$context", tpCopyContext, Var.VAR_LOCAL, 0));
			impl.addMethod(copyV);
			if (!s.isInterfaceOnly()) {
				copyV.body = new Block();
				Var v = new LVar(0,"node",impl.getType(),Var.VAR_LOCAL,0);
				if (isNodeKind(impl.super_types[0].getStruct())) {
					CallExpr cae = new CallExpr(0,new SuperExpr(),
						new SymbolRef<Method>("copyTo"),null,new ENode[]{new LVarExpr(0,tn), new LVarExpr(0,cc)});
					v.init = new CastExpr(0,impl.getType(),cae);
					copyV.block.addSymbol(v);
				} else {
					v.init = new CastExpr(0,impl.getType(),new LVarExpr(0,tn));
					copyV.block.addSymbol(v);
				}
				foreach (Field f; impl.members) {
					if (f.isAbstract() || f.isStatic())
						continue;
					{	// check if we may not copy the field
						UserMeta fmeta = (UserMeta)f.getMeta(mnAtt);
						if (fmeta == null)
							fmeta = (UserMeta)f.getMeta(mnRef);
						if (fmeta != null && !fmeta.getZ(nameCopyable))
							continue; // do not copy the field
					}
					boolean isNode = (VNodeUtils.isNodeKind(f.getType()));
					boolean isArr = f.getType().isInstanceOf(tpNodeSpace);
					boolean isSet = f.getType().isInstanceOf(tpNodeExtSpace);
					if (f.getMeta(mnAtt) != null && (isNode || isArr)) {
						if (isArr) {
							CallExpr cae = new CallExpr(0,
								new IFldExpr(0,new LVarExpr(0,v),f),
								new SymbolRef<Method>("copyFrom"),
								null,
								new ENode[]{new IFldExpr(0,new ThisExpr(),f),new LVarExpr(0,cc)});
							copyV.block.stats.append(new ExprStat(0,cae));
						}
						else if (f.isFinal()) {
							if (isNode) {
								copyV.block.stats.append(
									new ExprStat(0,
										new CallExpr(0,
											new IFldExpr(0,new ThisExpr(),f),
											new SymbolRef<Method>("copyTo"),
											null,
											new ENode[]{new IFldExpr(0,new LVarExpr(0,v),f),new LVarExpr(0,cc)}
										)
									)
								);
							}
						} else {
							CallExpr cae = new CallExpr(0,
								new IFldExpr(0, new ThisExpr(),f),
								new SymbolRef<Method>("copy"),
								null,
								new ENode[]{new LVarExpr(0,cc)});
							copyV.block.stats.append(
								new IfElseStat(0,
									new BinaryBoolExpr(0, env.coreFuncs.fObjectBoolNE,
										new IFldExpr(0,new ThisExpr(),f),
										new ConstNullExpr()
										),
									new ExprStat(0,
										new AssignExpr(0,
											new IFldExpr(0,new LVarExpr(0,v),f),
											new CastExpr(0,f.getType(),cae)
										)
									),
									null
								)
							);
						}
					} else {
						if (!f.isFinal()) {
							copyV.block.stats.append(
								new ExprStat(0,
									new AssignExpr(0,
										new IFldExpr(0,new LVarExpr(0,v),f),
										new IFldExpr(0,new ThisExpr(),f)
									)
								)
							);
						}
					}
				}
				copyV.block.stats.append(new ReturnStat(0,new LVarExpr(0,v)));
				env.runProcessorsOn(copyV);
			}
		}

		if (s.isInterfaceOnly())
			return;

		// fix methods
		foreach(Field f; impl.members; !f.isStatic()) {
			UserMeta fmatt = (UserMeta)f.getMeta(mnAtt);
			UserMeta fmref = (UserMeta)f.getMeta(mnRef);
			UserMeta fmsym = (UserMeta)f.getMeta(mnSym);
			if (fmatt != null || fmref != null || fmsym != null) {
				boolean isArr = f.getType().isInstanceOf(tpNodeSpace);
				boolean isSymRef = f.getType().isInstanceOf(tpNodeSymbolRef);
				if (isArr && !f.isAbstract()) {
					f.init = new CastExpr(f.pos, f.getType(),
						new IFldExpr(f.pos,
							new SFldExpr(f.pos, iface.resolveField(("nodeattr$"+f.sname).intern(), true)),
							tpAttrSlot.resolveField("defaultValue")
						)
					);
				}
				if (isSymRef && !f.isAbstract()) {
					f.init = new ReinterpExpr(f.pos, f.getType(), new NewExpr(f.pos, f.getType().getMetaSupers()[0], ENode.emptyArray));
				}
			}
			if (f.isVirtual() && f.getMetaPacked() == null) {
				fixSetterMethod(impl, f, fmatt, fmref, fmsym);
				fixGetterMethod(impl, f, fmatt, fmref, fmsym);
			}
		}
	}

	private Struct makeNodeValuesClass(Struct iface, Struct impl) {
		foreach (Struct s; iface.members; s.sname == "VVV")
			return s; // already generated or manually specified
		Struct s = this.env.newStruct("VVV",iface,ACC_PUBLIC|ACC_STATIC|ACC_SYNTHETIC,new JavaClass(),null);
		if (!s.isAttached())
			iface.members += s;
	super_vvv:
		foreach (TypeRef st; iface.super_types; isNodeKind(st.getStruct()) || nameNode.equals(st.getStruct().qname()) || nameANode.equals(st.getStruct().qname())) {
			Struct stv = null;
			foreach (Struct v; st.getStruct().members; v.sname == "VVV") {
				s.super_types += new TypeRef(v.getType());
				break super_vvv;
			}
		}

		Constructor ctor = new Constructor(getContext(), ACC_PUBLIC);
		ctor.params += new LVar(0,"node",impl.getType(),Var.VAR_LOCAL,0);
		ctor.body = new Block();
		ctor.block.stats += new ExprStat(new CtorCallExpr(0,new SuperExpr(),new ENode[]{new LVarExpr(0,ctor.params[0])}));
		s.members += ctor;

		foreach (Field f; impl.members; !f.isStatic() && !f.isAbstract() && !f.isFinal() && f.getMeta(mnUnVersioned) == null) {
			Field sf = new Field(f.sname,f.getType(),ACC_SYNTHETIC);
			s.members += sf;
			ctor.block.stats += new ExprStat(new AssignExpr(0,new IFldExpr(0,new ThisExpr(),sf),new IFldExpr(0,new LVarExpr(0,ctor.params[0]),f,true)));
		}

		env.runProcessorsOn(s);
		return s;
	}

	private void collectAllAttrFields(Vector<Field> aflds, Struct iface) {
		if (iface == null)
			return;
		if (iface.qname().equals(nameANode)) {
			aflds.append(iface.resolveField("parent"));
			return;
		}
		if (!isNodeKind(iface))
			return;
	next_fld:
		foreach (Field f; iface.members; !f.isStatic() && (f.getMeta(mnAtt) != null || f.getMeta(mnRef) != null)) {
			foreach (Field af; aflds; f == af || f.sname == "parent")
				continue next_fld;
			aflds.append(f);
		}
		foreach (TypeRef st; iface.super_types)
			collectAllAttrFields(aflds, st.getStruct());
	}

	private Field getField(Struct s, String name) {
		Field f = s.resolveField(name, false);
		if (f != null)
			return f;
		throw new CompilerException(s,"Auto-generated field with name "+name+" is not found");
	}

	private boolean hasMethod(Struct s, String name) {
		s = s.checkResolved();
		foreach (Method m; s.members; m.hasName(name)) return true;
		return false;
	}

	private Method getMethod(Struct s, String name) {
		s = s.checkResolved();
		foreach (Method m; s.members; m.hasName(name)) return m;
		foreach (TypeRef st; s.super_types) {
			Struct sups = st.getStruct();
			Method m = getMethod(sups, name);
			if (m != null)
				return m;
		}
		return null;
	}

	private void fixGetterMethod(Struct s, Field f, UserMeta fmatt, UserMeta fmref, UserMeta fmsym) {
		boolean isAtt = (fmatt != null);
		boolean isSet = f.getType().isInstanceOf(tpNodeExtSpace);

		if (isSet)
			return;

		Method get_var = f.getGetterMethod();
		if (get_var == null || get_var.isStatic())
			return;
		if (get_var.getMeta(mnAtt) != null || get_var.getMeta(mnRef) != null)
			return; // already generated
		if (get_var.isAbstract()) {
			if (fmatt == null && fmref == null && fmsym == null)
				return;
			if (isAtt && !fmatt.getZ(nameExtData) || !isAtt && !fmref.getZ(nameExtData))
				return;
			String fname = ("nodeattr$"+f.sname).intern();
			Field fatt = Env.ctxTDecl(f).resolveField(fname);
			get_var.setAbstract(false);
			if (get_var.isSynthetic())
				get_var.setFinal(true);
			Block body = new Block();
			body.stats += new CastExpr(f.getType(),new CallExpr(0,new SFldExpr(0,fatt),new SymbolRef<Method>("get"),null,new ENode[]{new ThisExpr()}));
			get_var.body = body;
			env.runProcessorsOn(body);
			return;
		}
		if (get_var.isSynthetic())
			get_var.setFinal(true);

		if (isAtt)
			get_var.setMeta(new UserMeta(mnAtt)).resolve(null);
		else
			get_var.setMeta(new UserMeta(mnRef)).resolve(null);
	}

	private void fixSetterMethod(Struct s, Field f, UserMeta fmatt, UserMeta fmref, UserMeta fmsym) {
		boolean isAtt = (fmatt != null);
		boolean isArr = f.getType().isInstanceOf(tpNodeSpace);
		boolean isSet = f.getType().isInstanceOf(tpNodeExtSpace);

		if (isSet)
			return;

		Method set_var = f.getSetterMethod();
		if (set_var == null || set_var.isStatic())
			return;
		if (set_var.getMeta(mnAtt) != null || set_var.getMeta(mnRef) != null)
			return; // already generated

		Var value = null;
		foreach (Var fp; set_var.params; fp.kind == Var.VAR_LOCAL) {
			value = fp;
			break;
		}
		if (value == null) {
			set_var.reportError().log("Cannot find a value to assign parameter");
			return;
		}

		Field fatt = null;
		if (fmatt != null || fmref != null || fmsym != null)
			fatt = Env.ctxTDecl(f).resolveField(("nodeattr$"+f.sname).intern());

		if (set_var.isAbstract()) {
			if (fatt == null)
				return;
			if (isAtt && !fmatt.getZ(nameExtData) || !isAtt && !fmref.getZ(nameExtData))
				return;
			set_var.setAbstract(false);
			if (set_var.isSynthetic())
				set_var.setFinal(true);
			Block body = new Block();
			body.stats += new CallExpr(0,new SFldExpr(0,fatt),new SymbolRef<Method>("set"),null,new ENode[]{new ThisExpr(),new LVarExpr(0,value)});
			set_var.body = body;
			env.runProcessorsOn(body);
			return;
		}

		if (set_var.isSynthetic())
			set_var.setFinal(true);
		Block body = set_var.block;
		if (!isArr && isAtt) {
			Var old = new LVar(body.pos,"$old",f.getType(),Var.VAR_LOCAL,ACC_FINAL);
			old.init = new IFldExpr(0,new ThisExpr(),f);
			body.stats.insert(0,old);
			env.runProcessorsOn(old);
			ENode p_st = new ExprStat(0,
						new CallExpr(0,
							new ThisExpr(),
							new SymbolRef<Method>(nameCallbackDataSet),
							null,
							new ENode[] {
								new SFldExpr(f.pos, fatt),
								new LVarExpr(0, old),
								new LVarExpr(0, value),
								new ConstIntExpr(-1)
							}
						)
					);
			body.stats.append(p_st);
			env.runProcessorsOn(p_st);
		}
		if (isAtt)
			set_var.setMeta(new UserMeta(mnAtt)).resolve(null);
		else
			set_var.setMeta(new UserMeta(mnRef)).resolve(null);
	}

	boolean fixAccessInGetter(Field f, IFldExpr fe, INode parent, AttrSlot slot) {
		if!(fe.obj instanceof ThisExpr && fe.var == f && !fe.var.isFinal())
			return true;
		if (parent instanceof AssignExpr && slot.name == "lval")
			return true;
		if (!fe.getType().isInstanceOf(tpNode))
			return true;
		Method csm = getCodeGet();
		ANode rewriter = csm.body;
		if (rewriter instanceof RewriteMatch)
			rewriter = rewriter.matchCase(fe);
		Hashtable<String,Object> args = new Hashtable<String,Object>();
		RewriteContext rctx = new RewriteContext(getContext(), fe, args);
		ANode rn = (ANode)rewriter.doRewrite(rctx);
		rn = fe.replaceWithNode(~rn, parent, slot);
		env.runProcessorsOn(rn);
		return false;
	}
	boolean fixAssignInSetter(Field f, AssignExpr ae, INode parent, AttrSlot slot) {
		if!(ae.lval instanceof IFldExpr && ((IFldExpr)ae.lval).obj instanceof ThisExpr && ((IFldExpr)ae.lval).var == f)
			return true;
		Method csm = getCodeSet();
		ANode rewriter = csm.body;
		if (rewriter instanceof RewriteMatch)
			rewriter = rewriter.matchCase(ae);
		Hashtable<String,Object> args = new Hashtable<String,Object>();
		RewriteContext rctx = new RewriteContext(getContext(), ae, args);
		ANode rn = (ANode)rewriter.doRewrite(rctx);
		rn = ae.replaceWithNode(~rn,parent,slot);
		env.runProcessorsOn(rn);
		return false;
	}
}

public final class VNodeBE_FixResolve extends BackendProcessor {

	@forward
	private VNodeUtils utils;

	public VNodeBE_FixResolve(Env env, int id) { super(env,id,KievBackend.Java15); }
	public String getDescr() { "VNode fix resolved" }

	////////////////////////////////////////////////////
	//	   PASS - preGenerate                         //
	////////////////////////////////////////////////////

	public void process(ANode node, Transaction tr) {
		if (node instanceof CompilationUnit) {
			CompilationUnit cu = (CompilationUnit)node;
			WorkerThreadGroup wthg = (WorkerThreadGroup)Thread.currentThread().getThreadGroup();
			if (wthg.setProcessorRun(cu,this))
				return;
			tr = Transaction.enter(tr,"VNodeBE_FixResolve");
			try {
				doProcess(node);
			} finally { tr.leave(); }
		}
	}

	public void doProcess(ANode:ANode node) {
		return;
	}

	public void doProcess(SyntaxScope:ANode ss) {
		foreach (ANode dn; ss.members)
			this.doProcess(dn);
	}

	final Struct getIFaceOfImpl(Struct impl) {
		if (impl.parent() instanceof Struct) {
			Struct iface = (Struct)impl.parent();
			if (iface.isInterface() && impl.isClazz() && iface.iface_impl == impl)
				return iface;
		}
		return null;
	}

	final boolean isNodeImpl(Struct s) {
		if (s.isClazz() && s.getMeta(mnNode) != null)
			return true;
		Struct iface = getIFaceOfImpl(s);
		if (iface != null && iface.getMeta(mnNode) != null)
			return true;
		return false;
	}

	public void doProcess(Struct:ANode s) {
		if (s.isInterface() && !s.isMixin() || !isNodeImpl(s)) {
			foreach(Struct sub; s.members)
				doProcess(sub);
			return;
		}

		if (utils == null)
			utils = new VNodeUtils(getContext());

		Struct iface = getIFaceOfImpl(s);
		if (iface == null)
			iface = s;
		Struct impl;
		if (s.isClazz())
			impl = s;
		else
			impl = s.iface_impl;

		foreach(Constructor ctor; impl.members; !ctor.isStatic())
			fixFinalFieldsInit(ctor.block);
	}

	private void fixFinalFieldsInit(Block block) {
		for (int i=0; i < block.stats.length; i++) {
			ANode stat = block.stats[i];
			if (stat instanceof Block) {
				fixFinalFieldsInit((Block)stat);
				continue;
			}
			if (stat instanceof ExprStat) stat = stat.expr;
			if (stat instanceof AssignExpr && stat.lval instanceof IFldExpr) {
				IFldExpr fe = (IFldExpr)((AssignExpr)stat).lval;
				if (fe.obj instanceof ThisExpr && fe.var.isFinal() && fe.var.getMeta(mnAtt) != null) {
					Field f = fe.var;
					fe.setAsField(true);
					Field fatt = Env.ctxTDecl(f).resolveField(("nodeattr$"+f.sname).intern());
					ENode p_st = new ExprStat(0,
								new CallExpr(0,
									new ThisExpr(),
									new SymbolRef<Method>(nameCallbackDataSet),
									null,
									new ENode[] {
										new SFldExpr(fe.pos, fatt),
										new ConstNullExpr(),
										new IFldExpr(fe.pos, new ThisExpr(), f),
										new ConstIntExpr(-1)
									}
								)
							);
					block.stats.insert(i+1, p_st);
					env.runProcessorsOn(p_st);
				}
			}
		}
	}

}
