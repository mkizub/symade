package kiev.transf;

import syntax kiev.Syntax;

import kiev.compiler.*;

/**
 * @author Maxim Kizub
 *
 */

public abstract class AbstractProcessor implements Constants {

	public final Env env;
	public final int id;

	public AbstractProcessor(Env env, int id) {
		this.env = env;
		this.id = id;
	}
	public abstract boolean isEnabled();
	public abstract boolean isDisabled();
	public abstract String getDescr();
	public abstract void process(ANode node, Transaction tr);

	public PluginNodeProcessor getProcessor() { (PluginNodeProcessor)env.getNodeProcessor() }

	public ANodeContext getContext() { ((WorkerThread)Thread.currentThread()).semantic_context }

	public static String getPropS(String base, String name, String dflt) {
		String fname = base+"."+name;
		String val = System.getProperty(fname,dflt);
		if (val != null)
			val = val.trim().intern();
		//env.reportDebug().log("Loaded '{}' as '{}'", fname, val);
		return val;
	}
}

