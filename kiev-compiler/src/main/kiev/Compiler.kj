	private Map<KievExt, Boolean> command_extensions = new HashMap<KievExt, Boolean>();

	{
		setExtension(false, "view");
		setExtension(false, "vnode");
		setExtension(false, "dflow");
		setExtension(false, "xpath");
	}

	public void systemExit(int code) {
		if (system_exit && !run_from_ide)
			System.exit(code);
		throw new CompilationAbortError();
	}

	public String getCompilerClasspath() {
		return compiler_classpath;
	}

	public PluginNodeProcessor getNodeProcessor() {
		return processor;
	}

	public FrontendThreadGroup getFrontendThreadGroup() {
		return frontendThreadGroup;
	}

	public Map<KievExt, Boolean> getCmdLineExtSet() {
		return command_extensions;
	}

	public void setExtension(boolean enabled, String s) {
		KievExt ext;
		try {
			ext = KievExt.fromString(s);
		} catch(RuntimeException e) {
			System.out.println("Unknown pragma 's'");
			return;
		}
		int i = (int)ext;
		command_extensions.put(ext, Boolean.valueOf(enabled));
	}

	public void runServer(InetAddress addr, int port) {
		server = new ServerSocket(port,2,addr);
		System.out.println("Server mode: "+server);
		for(;;) {
			socket = server.accept();
			System.out.println("Incoming connection "+socket);
			System.setIn(new DataInputStream(socket.getInputStream()));
			System.setOut(new PrintStream(socket.getOutputStream()));
			System.setErr(new PrintStream(socket.getOutputStream()));
			String[] args = getCommandLine();
			run(args);
			socket.close();
			System.setIn(system_in);
			System.setOut(system_out);
			System.setErr(system_err);
			System.out.println("Done.");
		}
	}

	public void runIncremental(String[] args) {
		System.out.println("Incremental mode");
		System.setIn(new DataInputStream(System.in));
		for(;;) {
			args = getCommandLine();
			printargs(args);
			run(args);
		}
	}

	public static void printargs(String[] args) {
		StringBuffer sb = new StringBuffer();
		foreach(String arg; args; arg != null) {
			sb.append(arg).append(' ');
		}
		System.out.println(sb.toString());
	}

	public String[] getCommandLine() {
	start:;
		String[] args;
		System.out.print("kiev> ");
		System.out.flush();
		System.gc();
		String cmd = ((DataInputStream)System.in).readLine();
		System.out.println("Command "+cmd);
		if( cmd == null ) {
			args = new String[]{"-q"};
			return args;
		} else if( cmd.length() == 0 ) {
			args = new String[0];
			return args;
		}
		StringTokenizer st = new StringTokenizer(cmd);
		args = new String[st.countTokens()];
		int i=0;
		foreach(Object s; st) args[i++] = (String)s;
		if( args[0].startsWith("-q") ) {
			System.out.println("Bye.");
			if( server != null ) server.close();
			if( socket != null ) socket.close();
			this.systemExit(0);
		}
		else if( args[0].equals("?") ) {
			System.out.println(
				"[options] file.java ...\t - set options and compile file(s)\n"+
				"-q\t\t - quit\n"+
				"?\t\t - this help\n"+
				"{Enter}\t\t - make project\n"
			);
			goto start;
		}
		return args;
	}

	public String makePath(String path) throws java.io.IOException {
		File file = new File(path);
		if (root_dir != null && !file.isAbsolute())
			file = new File(root_dir, path);
		return file.getCanonicalPath();
	}

	private String[] parseArgs(String[] args) throws Exception {
		int a = 0;
		if( args==null ) args = new String[0];
		int alen = args.length;
		for(a=0; a < alen ;a++) {
			if (args[a].equals("-debug"))
				ClassLoader.getSystemClassLoader().setDefaultAssertionStatus(true);
			if (args[a].equals("-no-system-exit")) {
				System.out.println(Compiler.version);
				System.out.print("compiler args: ");
				foreach (String a; args ) {
					System.out.print(" "+a);
				}
				System.out.println();
			}
		}
		try {
			for(a=0; a < alen ;a++) {
				boolean onoff = true;
				if( args[a] == null ) continue;
				if( args[a].equals("--") ) {
					args[a] == null;
					break;
				}
				if( args[a].equals("-pipe") || args[a].equals("-server") ) {
					args[a] = null;
					if( args[a+1].charAt(0) == '-' ) continue;
					if( args[a+1].endsWith(".java") || args[a+1].endsWith(".kj") ) continue;
					args[++a] = null;
					continue;
				}
				else if( args[a].equals("-?") || args[a].equals("-h") || args[a].equals("-help") ) {
					printHelp();
					return new String[0];
				}

				if( args[a].startsWith("-no-") ) {
					args[a] = args[a].substring(3);
					onoff = false;
				}

				if( args[a].equals("-disable") ) {
					args[a] = null;
					setExtension(!onoff,args[++a]);
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-enable") ) {
					args[a] = null;
					setExtension(onoff,args[++a]);
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-prompt")) {
					errorPrompt = onoff;
					args[a] = null;
				}
				else if( args[a].equals("-g") ) {
					debugOutputA = onoff;
					debugOutputT = onoff;
					debugOutputC = onoff;
					debugOutputL = onoff;
					debugOutputV = onoff;
					debugOutputS = onoff;
					args[a] = null;
				}
				else if( args[a].startsWith("-g:")) {
					if( args[a].indexOf('a') > 0 )
						debugOutputA = onoff;
					if( args[a].indexOf('t') > 0 )
						debugOutputT = onoff;
					if( args[a].indexOf('c') > 0 )
						debugOutputC = onoff;
					if( args[a].indexOf('l') > 0 )
						debugOutputL = onoff;
					if( args[a].indexOf('v') > 0 )
						debugOutputV = onoff;
					if( args[a].indexOf('s') > 0 )
						debugOutputS = onoff;
					args[a] = null;
				}
				else if( args[a].equals("-debug")) {
					args[a] = null;
					String dbg = args[++a];
					args[a] = null;
					System.out.println("Debugging: "+onoff);
					if( dbg.indexOf("stat",0) >= 0 ) {
						System.out.println("\tstatement generation");
						this.traceStatGen	= onoff;
					}
					if( dbg.indexOf("instr",0) >= 0 ) {
						System.out.println("\tinstractions generation");
						this.traceInstrGen	= onoff;
					}
					if( dbg.indexOf("bcread",0) >= 0 ) {
						System.out.println("\tbytecode .class reading");
						this.traceBytecodeRead = onoff;
					}
					if( dbg.indexOf("bcwrite",0) >= 0 ) {
						System.out.println("\tbytecode .class writing");
						this.traceBytecodeWrite = onoff;
					}
					if( dbg.indexOf("resolv",0) >= 0 ) {
						System.out.println("\tidentifier resolving");
						this.debugResolve	= onoff;
					}
					if( dbg.indexOf("operat",0) >= 0 ) {
						System.out.println("\toperator resolving");
						this.debugOperators	= onoff;
					}
					if( dbg.indexOf("member",0) >= 0 ) {
						System.out.println("\tmembers attaching (AST generation)");
						this.debugMembers	= onoff;
					}
					if( dbg.indexOf("multimethod",0) >= 0 ) {
						System.out.println("\tMultiMethod generation");
						this.debugMultiMethod	= onoff;
					}
					if( dbg.indexOf("types",0) >= 0 ) {
						System.out.println("\tvar/field types (from control flow)");
						this.debugNodeTypes		= onoff;
					}
					this.debug = onoff;
					if (onoff) {
						this.verbose = true;
						this.report_totals = onoff;
					}
					continue;
				}
				else if( args[a].equals("-verbose") || args[a].equals("-v") ) {
					this.verbose = onoff;
					args[a] = null;
					if (onoff)
						this.report_totals = onoff;
					continue;
				}
				else if( args[a].equals("-verify") ) {
					this.verify = onoff;
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-safe") ) {
					this.safe = onoff;
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-target") ) {
					args[a] = null;
					if (onoff && a+1 < args.length) {
						this.target = Integer.parseInt(args[a+1]);
						a++;
						args[a] = null;
					} else {
						this.target = 0;
					}
				}
				else if( args[a].equals("-root")) {
					args[a] = null;
					if( onoff ) {
						File f = new File(args[++a]);
						this.root_dir = f.getCanonicalPath();
						args[a] = null;
					} else {
						this.root_dir = null;
					}
					continue;
				}
				else if( args[a].equals("-d")) {
					args[a] = null;
					if( onoff ) {
						this.output_dir = makePath(args[++a]);
						args[a] = null;
					} else {
						this.output_dir = null;
					}
					continue;
				}
				else if( args[a].equals("-ds")) {
					args[a] = null;
					if( onoff ) {
						this.dump_src_dir = makePath(args[++a]);
						args[a] = null;
					} else {
						this.dump_src_dir = null;
					}
					continue;
				}
				else if( args[a].equals("-btd")) {
					args[a] = null;
					if( onoff ) {
						this.btd_dir = makePath(args[++a]);
						args[a] = null;
					} else {
						this.btd_dir = null;
						this.prefer_source = true;
					}
					continue;
				}
				else if( args[a].equals("-p") || args[a].equals("-project") ) {
					args[a] = null;
					if( onoff ) {
						this.project_file = makePath(args[++a]);
						args[a] = null;
					} else
						this.project_file = null;
					continue;
				}
				else if( args[a].equals("-makedep") ) {
					args[a] = null;
					this.interface_only = onoff;
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-classpath")) {
					args[a] = null;
					if( onoff ) {
						this.compiler_classpath = args[++a];
						args[a] = null;
					} else
						this.compiler_classpath = null;
					continue;
				}
				else if( args[a].startsWith("-prefer:")) {
					String prefer = args[a].substring(8);
					args[a] = null;
					if (prefer.equals("source"))
						this.prefer_source = onoff;
					else if (prefer.equals("newer"))
						this.prefer_source = !onoff;
					else
						throw new RuntimeException("Must be either -prefer:source or -prefer:newer");
					continue;
				}
				else if( args[a].startsWith("-ps")) {
					args[a] = null;
					this.prefer_source = onoff;
					continue;
				}
				else if( args[a].equals("-gui")) {
					args[a] = null;
					this.run_gui   = onoff;
					if (onoff)
						System.setProperty("symade.unversioned","false");
					if (a+1 < args.length) {
						if (args[a+1].equalsIgnoreCase("swing")) {
							this.run_gui_swing = onoff;
							a++;
							args[a] = null;
						}
						else if (args[a+1].equalsIgnoreCase("swt")) {
							this.run_gui_swt = onoff;
							a++;
							args[a] = null;
						}
					}
					if (onoff && !this.run_gui_swt && !this.run_gui_swing)
						this.run_gui_swing = true;
					continue;
				}
				else if( args[a].startsWith("-gui:")) {
					String toolkit = args[a].substring(5);
					args[a] = null;
					this.run_gui   = onoff;
					if (onoff)
						System.setProperty("symade.unversioned","false");
					if (toolkit.equalsIgnoreCase("swing"))
						this.run_gui_swing = onoff;
					else if (toolkit.equalsIgnoreCase("swt"))
						this.run_gui_swt = onoff;
					else
						throw new RuntimeException("GUI toolkit must be swt or swing, but found "+toolkit);
					if (onoff && !this.run_gui_swt && !this.run_gui_swing)
						this.run_gui_swing = true;
					continue;
				}
				else if( args[a].equals("-batch") ) {
					args[a] = null;
					System.setProperty("symade.unversioned",String.valueOf(onoff));
					if (onoff)
						this.run_gui = false;
					continue;
				}
				else if( args[a].equals("-javacerrors")) {
					this.javacerrors = onoff;
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-totals")) {
					this.report_totals = onoff;
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-ide")) {
					this.run_from_ide = onoff;
					this.system_exit = !onoff;
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-system-exit")) {
					this.system_exit = onoff;
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-j") || args[a].equals("-jobs") ) {
					args[a] = null;
					if (onoff && a+1 < args.length) {
						this.jobThreads = Integer.parseInt(args[a+1]);
						a++;
						args[a] = null;
					} else {
						this.jobThreads = 0;
					}
					continue;
				}
				else if( args[a].equals("-warn")) {
					this.nowarn = !onoff;
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-codewarn")) {
					this.code_nowarn = !onoff;
					args[a] = null;
					continue;
				}
//				else if( args[a].equals("-test")) {
//					args[a++] = null;
//					String[] errs = args[a].split(":");
//					args[a] = null;
//					Compiler.testError = CError.valueOf(errs[0]);
//					Compiler.testErrorLine = Integer.parseInt(errs[1]);
//					Compiler.testErrorOffs = Integer.parseInt(errs[2]);
//					continue;
//				}
				else if( args[a].startsWith("-D") ) {
					Properties ps = System.getProperties();
					String prop, value;
					args[a] = args[a].substring(2);
					int indx = args[a].indexOf("=");
					if( indx < 0 ) {
						prop = args[a];
						value = "";
					} else {
						prop = args[a].substring(0,indx);
						value = args[a].substring(indx+1);
					}
					if( onoff ) {
						System.getProperties().setProperty(prop,value);
					} else {
						System.getProperties().remove(prop);
					}
					args[a] = null;
					continue;
				}
				else if( args[a].equals("-prop")) {
					args[a] = null;
					String fname = args[++a];
					args[a] = null;
					try {
						File file = new File(fname);
						if (!file.isAbsolute() && root_dir != null)
							file = new File(root_dir, fname);
						InputStream inp = new FileInputStream(file);
						//System.getProperties().load(new InputStreamReader(inp, "UTF-8"));
						System.getProperties().load(inp);
					} catch( IOException e ) {
						throw new RuntimeException("Error opening property file: "+e, e);
					}
					continue;
				}
				else if( args[a].startsWith("@") ) {
					String fname = args[a].substring(1);
					args[a] = null;
					RandomAccessFile f = new RandomAccessFile(fname, "r");
					byte[] buf = new byte[(int)f.length()];
					f.readFully(buf);
					f.close();
					StringTokenizer st = new StringTokenizer(new String(buf));
					String[] arr = new String[st.countTokens()];
					for (int i=0; i < arr.length; i++)
						arr[i] = st.nextToken();
					arr = parseArgs(arr);
					for (int i=0; i < arr.length; i++)
						args = (String[])Arrays.insert(args,arr[i],a+i+1);
					alen = args.length;
					continue;
				}
				else if( hasWildcards(args[a]) ) {
					try {
						args = addExpansion(args,a);
					} catch( IOException e ) {
						throw new RuntimeException("Error in arguments: "+e, e);
					}
				}
			}

			if (this.target == 0) {
				String jv = System.getProperty("java.specification.version");
				if ("1.6".equals(jv))
					this.target = 6;
				else if ("1.8".equals(jv))
					this.target = 8;
				else {
					this.target = 8;
					System.out.println("Java version '"+jv+"' not known, default: -target 8 (JVM 1.8)");
				}
			}

			switch (this.target) {
			case 6: case 8:
				break;
			default:
				throw new RuntimeException("JVM target version '"+this.target+"' not supported");
			}

			String[] args1 = new String[0];
			for(int i=0; i < args.length; i++) {
				if( args[i] == null ) continue;
				String fn = args[i].replace('/', File.separatorChar).replace('\\', File.separatorChar);
				if (fn.startsWith("./"))
					fn = fn.substring(2);
				args1 = (String[])Arrays.appendUniq(args1,fn);
			}
			args = args1;
		} catch( ArrayIndexOutOfBoundsException e) {
			args = new String[0];
		}
		return args;
	}

	// returns exit code
	public static int run(String[] args) {
		return new Compiler().compile(args);
	}
	public int compile(String[] args) {
		//this.interface_only = false;

		try {
			args = parseArgs(args);
		} catch (Exception e) {
			System.err.println(e.getMessage());
			return 1;
		}

		if (theEnv == null)
			theEnv = Env.createEnv();
		if (frontendThreadGroup == null)
			frontendThreadGroup = new FrontendThreadGroup(theEnv);
		if (processor == null)
			processor = new PluginNodeProcessor();

		Compiler.errorCount = 0;
		AtomicInteger errorCounter = theEnv.errorCounter;
		AtomicInteger warningCounter = theEnv.warningCounter;
		errorCounter.set(0);
		warningCounter.set(0);
		WorkerThreadGroup.reportTotals = this.report_totals;
		WorkerThreadGroup.reportMemory = this.report_totals && this.verbose;

		LoggingBuilderFactory logger = theEnv.getLogger();
		if      (debug)   logger.setLevel(LoggingLevel.DEBUG);
		else if (verbose) logger.setLevel(LoggingLevel.INFO);
		else if (nowarn)  logger.setLevel(LoggingLevel.ERROR);
		else              logger.setLevel(LoggingLevel.WARNING);

		theEnv.verboseOn         = this.verbose;
		theEnv.debugOn           = this.debug;
		theEnv.debugResolve      = this.debugResolve;
		theEnv.debugOperators    = this.debugOperators;
		theEnv.debugMembers      = this.debugMembers;
		theEnv.debugMultiMethod  = this.debugMultiMethod;
		theEnv.debugNodeTypes    = this.debugNodeTypes;

		if (root_dir != null)
			logger.setRootDir(root_dir);
		else
			logger.setRootDir(System.getProperty("user.dir"));

		processor.genVerifiable     = this.verify;
		processor.genEvenWithErrors = !this.safe;
		processor.genAsserts        = this.debugOutputA;
		processor.genTraces         = this.debugOutputT;
		processor.genContracts      = this.debugOutputC;
		processor.genDebugLineTable = this.debugOutputL;
		processor.genDebugLVarTable = this.debugOutputV;
		processor.genDebugSourceMap = this.debugOutputS;
		processor.traceBytecodeRead = this.traceBytecodeRead;
		processor.traceBytecodeWrite= this.traceBytecodeWrite;
		processor.traceStatGen      = this.traceStatGen;
		processor.traceInstrGen     = this.traceInstrGen;

		processor.genTargetJVM      = this.target;
		processor.genBackend        = this.useBackend;
		processor.genOutputDir      = new File(makePath(output_dir));
		if (btd_dir == null)
			processor.genBinTreeDumpDir = null;
		else
			processor.genBinTreeDumpDir = new File(makePath(btd_dir));

		KievExt[] ext_values = KievExt.values();
		Map<KievExt, Boolean> extensions = getCmdLineExtSet();
		for (Map.Entry<KievExt, Boolean> e : extensions.entrySet()) {
			if (e.getValue().booleanValue())
				processor.setEnabled(e.getKey());
			else
				processor.setDisabled(e.getKey());
		}

//		Kiev.root_dir = this.root_dir;
//		Kiev.output_dir = this.output_dir;
//		Kiev.dump_src_dir = this.dump_src_dir;
//		Kiev.btd_dir = this.btd_dir;

		if (theEnv != null && theEnv.proj != null) {
			foreach(FileUnit fu; frontendThreadGroup.theEnv.proj.enumerateAllCompilationUnits())
				fu.generated_files = null;
		}

		Vector cargs = new Vector();
		foreach (String arg; args)
			cargs.add(new CompilerParseInfo(arg, null, true));
		CompilerParseInfo[] argsArr = (CompilerParseInfo[])cargs.toArray(new CompilerParseInfo[cargs.size()]);
		runFrontEndParse(argsArr);
		Compiler.errorCount = errorCounter.get();
		if (errorCounter.get() > 0) {
			if (this.run_from_ide)
				return 1;
			this.systemExit(1);
		}

		runFrontEnd(frontendThreadGroup.roots);
		Compiler.errorCount = errorCounter.get();

		CompilerThreadGroup cmp_thrg = new CompilerThreadGroup(frontendThreadGroup, jobThreads);
		if (this.run_gui) {
			java.lang.reflect.Constructor ctor = Class.forName("kiev.gui.Main").getConstructor(WorkerThreadGroup.class, Compiler.class);
			ctor.newInstance(cmp_thrg, this);
			for(;;) Thread.sleep(10*1000);
		} else {
			if (errorCounter.get() == 0 && !this.interface_only)
				runBackEnd(cmp_thrg, this.useBackend);
			Compiler.errorCount = errorCounter.get();
			//if (Kiev.verbose) dumpGeneratedFiles(frontendThreadGroup.theEnv, argsArr);
			if (this.run_from_ide) {
				generateSourceToClassMapping();
				theEnv = null;
				frontendThreadGroup = null;
				processor = null;
				java.lang.Runtime.getRuntime().gc();
				//for(;;) Thread.sleep(10*1000);
				return errorCounter.get() > 0 ? 1 : 0;
			}
			this.systemExit(errorCounter.get() > 0 ? 1 : 0);
		}
		return errorCounter.get() > 0 ? 1 : 0;
	}

	public void runFrontEndParse(CompilerParseInfo[] args) {
		frontendThreadGroup.runFrontEndParseTask(this, args);
	}

	public void runFrontEnd(INode[] roots) {
		frontendThreadGroup.runTask(roots);
	}

	public void runBackEnd(CompilerThreadGroup thrg, KievBackend be) {
		if (be != null)
			processor.genBackend = be;
		else
			be = processor.genBackend;
		Compiler.reportProgress(theEnv, "Running back-end", be, 0);

		thrg.runTask();
	}

	private void generateSourceToClassMapping() {
		sourceToClassMapping = new HashMap<String, Set<String>>();
		if (theEnv == null || theEnv.proj == null)
			return;
		foreach (FileUnit fu; theEnv.proj.enumerateAllCompilationUnits()) {
			Set<String> set = new HashSet<String>();
			sourceToClassMapping.put(fu.pname(), set);
			if (fu.generated_files == null || fu.generated_files.length == 0) {
				continue;
			} else {
				set.addAll(java.util.Arrays.asList(fu.generated_files));
			}
		}
	}

	private void dumpGeneratedFiles(Env env, CompilerParseInfo[] args) {
		System.out.println("Generated files:");
		foreach (FileUnit fu; env.proj.enumerateAllCompilationUnits()) {
			if (fu.generated_files == null || fu.generated_files.length == 0) {
				System.out.println("    " + fu.pname() + ": none");
			} else {
				java.util.Arrays.sort(fu.generated_files);
				System.out.println("    " + fu.pname() + ": " + fu.generated_files.length);
				foreach (String f; fu.generated_files)
				System.out.println("        " + f);
			}
		}
//		foreach (CompilerParseInfo cpi; args) {
//			FileUnit fu = cpi.fu;
//			if (fu.generated_files == null || fu.generated_files.length == 0) {
//				System.out.println("    " + cpi.fname + ": none");
//			} else {
//				System.out.println("    " + cpi.fname + ": " + fu.generated_files.length);
//				foreach (String f; fu.generated_files)
//					System.out.println("        " + f);
//			}
//		}
	}

	public static void reportProgress(Env env, String msg, Object arg, long diff_time) {
		if (!env.verboseOn || msg == null)
			return;
		reportProgress(env, msg+" "+arg, diff_time);
	}
	public static void reportProgress(Env env, String msg, long diff_time) {
		if (!env.verboseOn || msg == null)
			return;
		String thread_idx = "?";
		if (Thread.currentThread() instanceof WorkerThread)
			thread_idx = String.valueOf(((WorkerThread)Thread.currentThread()).worker_id);
		while (thread_idx.length() < 2)
			thread_idx = " "+thread_idx;
		StringBuffer sb = new StringBuffer(79);
		sb.append("[").append(thread_idx).append(": ");
		sb.append(msg);
		if (diff_time >= 0) {
			String tm = String.valueOf(diff_time);
			for (int i = 70 - msg.length() - tm.length(); i > 0; i--)
				sb.append(' ');
			sb.append(' ').append(tm).append("ms ]");
		} else {
			for (int i = 73 - msg.length(); i > 0; i--)
				sb.append(' ');
			sb.append(" ]");
		}
		System.out.println(sb.toString());
		System.out.flush();
	}

	public void printHelp() {
		KievExt[] extensions = KievExt.values();
		StringBuffer exts = new StringBuffer();
		Map<KievExt, Boolean> ext_state = getCmdLineExtSet();
		for (int i=0, sz=0; i < extensions.length; i++) {
			try {
				KievExt ext = extensions[i];
				String s = ext.toString();
				if (sz + s.length() + 3 >= 70) {
					exts.append("\n\t");
					sz = 0;
				}
				sz += s.length() + 3;
				exts.append('"').append(s).append('"');
				Boolean state = ext_state.get(ext);
				if (state != null) {
					if (state.booleanValue())
						exts.append("(on) ");
					else
						exts.append("(off) ");
				} else {
					exts.append(' ');
				}
			} catch (ClassCastException e) {}
		}
		System.out.println(
 "Usage:  java kiev.Main [-g] [-debug x,y,z,..] [-prompt] [-i]\n"
+"           [-pipe] [-server]\n"
+"           [-d output_dir] [-verbose] [-classpath search_path]\n"
+"           [-D=var] [-verify] file.java ...\n"
+"\n"
+"  Each switch may be prepended by '-no' to change the default value.\n"
+"      For example, -no-project defeats the project feature.\n"
+"\n"
+" --  End of switches.  The allows the compiler to treat the\n"
+"     remainder of the command line as input files to compile.\n"
+"     This is necessary due to the syntax of certain options.\n"
+"\n"
+" -gui       Run the UI environment (default is Swing).\n"
+" -gui:swing run the Swing UI environment.\n"
+" -gui:swt   run the UI environment.\n"
+"        Default: run no GUI, only batch compilation.\n"
+"\n"
+" -g[:atclvs] Generate classes with debug info and other checks.  Parameters:\n"
+"		       Assert, Trace, Contracts, Linetable, Vartable, SourceMAP\n"
+" -debug opt1,opt2,...	- debug output, options are:\n"
+"    stat     statement generation\n"
+"    instr    instractions generation\n"
+"    bcread   bytecode .class reading\n"
+"    bcwrite  bytecode .class generation\n"
+"    resolv   identifier resolving\n"
+"    flags    flags change for members\n"
+"    member   members attaching (AST generation)\n"
+"    ast      AST tree\n"
+"    types    var/field types (inferred from control flow)\n"
+"\n"
+" -v or -verbose         Verbose operation.\n"
+" -warn                  Show warnings.\n"
+" -codewarn              Show codegeneration warnings.\n"
+" -prompt                Interactive compilation.\n"
+" -pipe [host][:port]    Connect to server at host:port\n"
+" -server [host][:port]  Kiev compiler is server at host:port;\n"
+"                        default is 127.0.0.1:1966\n"
+"\n"
+" -p or -project xxx     Sets the project file.  Default is no project.\n"
+"\n"
+" -classpath xxx   Sets the CLASSPATH; if not specified, the environment\n"
+"                  variable is used.\n"
+" -d               Output root directory.  Default: \"classes\".\n"
+"\n"
+" -verify          Generate verifiable code.\n"
+" -safe            Do not generate class files with compiler errors.\n"
+"\n"
+" -Dvar[=value]    Set compile-time constant.  Default value is \"\" or true.\n"
+"      To unset the value, use -no-Dvar (sets to null or false).\n"
+"      All periods ('.') in $Dvar are replaced with underscores ('_').\n"
+"      System properties provide predefined variables,	as supported by\n"
+"      (System.getProperties()).\n"
+"      The compile-time constants $FILE, $METHOD, $LINENO, and $DEBUG\n"
+"      are also defined.\n"
+" -disable \"extension\" completly disable the specified extension,\n"
+"      also you can manage extensions by pragmas in file headers,\n"
+"      complete list of extensions to enable/disable is:\n\t"
+       exts.toString()
			);
	}

/** is string not an option and has it embedded '*' or '?' characters?
 */
	private boolean hasWildcards(String s) {
        return
            s.length() > 0 &&
            s.charAt(0) != '-' &&
            (s.indexOf('*') >= 0 || s.indexOf("?") >= 0);
    }

/** does string s[soffset..] match pattern p[poffset..]?
 *  p can contain wildcards.
 */
	private boolean matches(String s, int soffset,
                           String p, int poffset) {
        if (poffset >= p.length())
            return soffset >= s.length();
        else if (p.charAt(poffset) == '*')
            return
                matches(s, soffset, p, poffset + 1) ||
                (soffset < s.length() &&
                 matches(s, soffset + 1, p, poffset));
        else
            return
                soffset < s.length() &&
                (p.charAt(poffset) == '?' ||
                 Character.toUpperCase(s.charAt(soffset)) ==
                 Character.toUpperCase(p.charAt(poffset))) &&
                matches(s, soffset + 1, p, poffset + 1);
    }

	/** add all files matching pattern string s to buffer expargs.
	*/
	private String[] addExpansion(String[] args, int pos) throws IOException {
		String s = args[pos].replace('/', File.separatorChar).replace('\\', File.separatorChar);
		File f = new File(makePath(s));
		String path = f.getParent();
		String name = f.getName();
		if (path == null)
			if (s.indexOf(File.separatorChar) == 0) path = "";
			else path = ".";
		File dir = new File(path + File.separatorChar);
		if (dir == null) return args;
		String[] files = dir.list();
		args[pos] = null;
		if (files != null) {
			for (int j = 0; j < files.length; j++) {
				if (matches(files[j], 0, name, 0)) {
					args = (String[])Arrays.appendUniq(args,path + File.separator + files[j]);
				}
			}
		}
		return args;
	}
}

