public class Compiler {
	public static final String version = "SymADE (v 0.6), (C) UAB MAKSINETA, 1997-2008, http://symade.com";

	public ServerSocket		server;
	public Socket			socket;
	public InputStream		system_in = System.in;
	public PrintStream		system_out = System.out;
	public PrintStream		system_err = System.err;

	private Env                 theEnv;
	private FrontendThreadGroup frontendThreadGroup;
	private PluginNodeProcessor processor;

	public boolean verbose				= false;
	public boolean debug				= false;
	public boolean debugResolve			= false;
	public boolean debugOperators		= false;
	public boolean debugMembers			= false;
	public boolean debugMultiMethod		= false;
	public boolean debugNodeTypes		= false;

	public boolean traceStatGen			= false;
	public boolean traceInstrGen		= false;
	public boolean traceBytecodeRead	= false;
	public boolean traceBytecodeWrite	= false;

	public boolean verify						= true;
	public boolean safe							= true;
	public boolean debugOutputA					= false;
	public boolean debugOutputT					= false;
	public boolean debugOutputC					= false;
	public boolean debugOutputL					= false;
	public boolean debugOutputV					= false;
	public boolean debugOutputS					= false;

	public boolean errorPrompt					= false;

	public boolean run_gui						= false;
	public boolean run_gui_swing				= false;
	public boolean run_gui_swt					= false;
	public boolean interface_only				= false;
	public boolean prefer_source				= false;

	public int     target						= 0;
	public String  root_dir						= null; // System.getProperty("user.dir")
	public String  project_file					= null;
	public String  output_dir					= "classes";
	public String  btd_dir						= ".btd";
	public String  dump_src_dir					= null; //".src";
	public String  compiler_classpath			= null;
	public boolean javacerrors					= false;
	public boolean report_totals				= false;
	public boolean nowarn						= false;
	public boolean code_nowarn					= true;
	public boolean run_from_ide					= false;
	public boolean system_exit					= true; // System.exit() or throw exception if disabled

	public int     jobThreads					= 0;

	public static Map<String, Set<String>> sourceToClassMapping = null;
	public static int errorCount                 = 0;

	public KievBackend useBackend = KievBackend.Java15;

//	public CError testError				= null;
//	public int    testErrorLine			= 0;
