package kiev.vtree;

import syntax kiev.Syntax;

import java.util.IdentityHashMap;

public abstract class CopyContext {
	public final ANodeContext toNodeContext;
	public final boolean copyOnlyAPI;
	public final boolean copyGlobalSymbols;

	public CopyContext(ANodeContext nodeContext, boolean copyOnlyAPI, boolean copyGlobalSymbols) {
		this.toNodeContext = nodeContext;
		this.copyGlobalSymbols = copyGlobalSymbols;
		this.copyGlobalSymbols = copyGlobalSymbols;
	}

	public abstract <N extends INode> N copyRoot(N node);
	public abstract <N extends INode> N copyFull(N node);
	public abstract Symbol copySymbol(Symbol node);
	public abstract void addCopyInfo(INode nold, INode nnew);
	public abstract INode getCopyOf(INode nold);
	public abstract void updateLinks();
}

public class Copier implements CopyContext {

	private final IdentityHashMap<INode,INode> map = new IdentityHashMap<INode,INode>();

	public Copier(ANodeContext nodeContext) {
		super(nodeContext, false, true);
	}

	public Copier(ANodeContext nodeContext, boolean copyOnlyAPI, boolean copyGlobalSymbols) {
		super(nodeContext, copyOnlyAPI, copyGlobalSymbols);
	}

	public <N extends INode> N copyRoot(N node) {
		N t = (N)node.copy(this);
		return t;
	}

	public <N extends INode> N copyFull(N node) {
		N t = copyRoot(node);
		updateLinks();
		return t;
	}

	public Symbol copySymbol(Symbol nold) {
		if (nold == null)
			return null;
		//if (!copyGlobalSymbols && nold.isGlobalSymbol())
		//	return nold;
		Symbol nnew = new Symbol(nold);
		addCopyInfo(nold, nnew);
		return nnew;
	}

	public void addCopyInfo(INode nold, INode nnew) {
		assert (map.get(nold) == null);
		map.put(nold,nnew);
	}

	public INode getCopyOf(INode nold) {
		return map.get(nold);
	}

	public void updateLinks() {
		foreach (INode node; map.values()) {
			foreach (AttrSlot attr; node.values(); !attr.isChild()) {
				if (attr instanceof SpaceAttrSlot) {
					INode[] arr = attr.getArray(node);
					for (int i=0; i < arr.length; i++) {
						INode nold = arr[i];
						INode nnew = map.get(nold);
						if (nnew != null && nold != nnew)
							arr[i] = nnew;
					}
				}
				else if (attr instanceof ScalarAttrSlot) {
					Object nold = attr.get(node);
					if (nold instanceof INode) {
						INode nnew = map.get(nold);
						if (nnew != null && nold != nnew)
							attr.set(node,nnew);
					}
				}
			}
			Object[] ext_data = node.asANode().getExtData();
			for (int i=0; i < ext_data.length; i++) {
				Object dat = ext_data[i];
				if (dat instanceof DataAttachInfo) {
					DataAttachInfo dai = (DataAttachInfo)dat;
					if (dai.p_data instanceof INode) {
						INode nold = (INode)dai.p_data;
						INode nnew = map.get(nold);
						if (nnew != null && nold != nnew)
							node.setVal(dai.p_slot,nnew);
					}
				}
			}
		}
	}
}


