package kiev.vtree;

import syntax kiev.Syntax;

import java.util.concurrent.atomic.AtomicLong;
import java.util.concurrent.atomic.AtomicInteger;

// Base context class.
// Holds only Env and flags about it's lifecycle.
public class ANodeContext {

	// Node environment
	public final Env theEnv;
	// Parent context
	public final ANodeContext prev;

	// this context is expired and nodes can be deleted
	public boolean expired;
	// this context is locked, i.e. nodes cannot be changed
	public boolean locked;

	public ANodeContext(Env theEnv) {
		this.theEnv = theEnv;
		this.prev = theEnv.getEnvContext();
	}

	public ANodeContext(Env theEnv, ANodeContext prev) {
		this.theEnv = theEnv;
		this.prev = prev;
	}

	public boolean inherits(ANodeContext ctx) {
		for (ANodeContext self = this; self != null; self = self.prev) {
			if (self == ctx)
				return true;
		}
		return false;
	}
}

// Context for global environment nodes (like standard types).
public class EnvContext extends ANodeContext {
	public EnvContext(Env theEnv) {
		super(theEnv, null);
	}
}

// Semantic nodes contexts.
public final class SemanticContext extends ANodeContext {
	public SemanticContext(ANodeContext prev) {
		super(prev.theEnv, prev);
	}
}

// Backend context.
public class BackendNodeContext extends ANodeContext {
	public final SemanticContext semantic_context;
	public BackendNodeContext(SemanticContext semantic_context) {
		super(semantic_context.theEnv, semantic_context);
		this.semantic_context = semantic_context;
	}
}

