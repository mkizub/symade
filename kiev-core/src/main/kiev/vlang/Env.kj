public interface NodeProcessor {
	boolean genAssertsEnabled();
	boolean genTracesEnabled();
	void runFrontEndProcessorsOn(ANode node);
	void runProcessorsOn(ANode node);
}

public interface BEndEnvFactory {
	public BEndEnv makeBEndEnv(Env env);
}
public interface BEndEnv {
	public DNode loadAnyDecl(String qname, ANodeContext context);
	public DNode actuallyLoadDecl(String qname, ANodeContext context);
	public Struct actuallyLoadDecl(Struct cl, ANodeContext context);
	public void generateFile(FileUnit fu);
	public void backendCleanup(ANode node);
	public void cleanupHashOfFails();
	public boolean existsTypeDecl(String qname, ANodeContext context);
}

public abstract class EnvThreadGroup extends ThreadGroup {

	// The environment of this thread group
	public final Env		  theEnv;
	// The current semantic context
	public ANodeContext       semantic_context;
	// The current java backend context
	public BackendNodeContext bend_context;
	// The current transaction of this thread group
	public Transaction		  transaction;

	public Env getEnv() {
		return theEnv;
	}

	public Project getProject() {
		return theEnv.proj;
	}

	public EnvThreadGroup(Env env, EnvThreadGroup parent, String name) {
		super(parent == null ? Thread.currentThread().getThreadGroup() : parent, name+"-group");
		this.theEnv = env;
	}
}

public abstract class EnvThread extends Thread {

	// The environment of this thread (and group)
	public final Env       		theEnv;
	// Filename of current file we process
	public String               current_file;

	public EnvThread(EnvThreadGroup wthg, Runnable r, String name) {
		super(wthg, r, name);
		this.theEnv = wthg.theEnv;
	}
}

/** Class Env is a static class that implements global
	static methods and data for kiev compiler
 */

public final class Env {

	private LoggingBuilderFactory					loggingBuilderFactory;

	/** Global node context */
	private EnvContext								envContext;

	/** for external threads */
	private static final ThreadLocal<ANodeContext>	threadContext = new ThreadLocal<ANodeContext>();

	private NodeProcessor							nodeProcessor;

	/** Type environment */
	@access(ro,ro,rw,rw)
	public StdTypes									tenv;

	/** Backend environment */
	private BEndEnv									benv;

	public Project									proj;

	public KievRoot									root;

	public CoreFuncs								coreFuncs;

	public final AtomicInteger						errorCounter = new AtomicInteger(0);
	public final AtomicInteger						warningCounter = new AtomicInteger(0);

	private final SymUUIDHash                       uuidToSymbolMap = new SymUUIDHash();
	private final Hashtable<Class, NodeCreator>     nodeTemplates   = new Hashtable<Class, NodeCreator>(128);
	private final Hashtable<Class, DataFlowInfo>    dfiTemplates    = new Hashtable<Class, DataFlowInfo>(128);

	private boolean									initialized;

	public boolean verboseOn;
	public boolean debugOn;
	public boolean debugResolve;
	public boolean debugOperators;
	public boolean debugMembers;
	public boolean debugMultiMethod;
	public boolean debugNodeTypes;

	public static Env getEnv() {
		Thread thr = Thread.currentThread();
		if (thr instanceof EnvThread)
			return ((EnvThread)thr).theEnv;
		ANodeContext context = threadContext.get();
		if (context == null)
			throw new IllegalStateException("getEnv() without thread context in "+Thread.currentThread());
		return context.theEnv;
	}

	public static Project getProject() {
		Thread thr = Thread.currentThread();
		if (thr instanceof EnvThread)
			return ((EnvThread)thr).theEnv.proj;
		ANodeContext context = threadContext.get();
		if (context == null)
			throw new IllegalStateException("getProject() without thread context in "+Thread.currentThread());
		return context.theEnv.proj;
	}

	public static synchronized Env createEnv() {
		Env env = new Env();
		return env;
	}

	public static ANodeContext getCurrentContext() {
		ThreadGroup thrg = Thread.currentThread().getThreadGroup();
		if (thrg instanceof EnvThreadGroup)
			return ((EnvThreadGroup)thrg).semantic_context;
		ANodeContext context = threadContext.get();
		if (context == null)
			throw new IllegalStateException("getCurrentContext() without thread context in "+Thread.currentThread());
		return context;
	}

	public static void setThreadContext(ANodeContext context) {
		threadContext.set(context);
	}

	public static ANodeContext getThreadContext() {
		return threadContext.get();
	}

	/** Private class constructor, use createEnv()+InitializeEnv()
	 */
	private Env() {
		this.loggingBuilderFactory = new DefaultLoggingBuilderFactory();
		this.envContext = new EnvContext(this);
	}

	public EnvContext          getEnvContext()         { return envContext; }
	public StdTypes            getTypeEnv()            { return tenv; }
	public BEndEnv             getBackendEnv()         { return benv; }
	public NodeProcessor       getNodeProcessor()      { return nodeProcessor; }
	public boolean             isInitialized()         { return initialized; }

	public Hashtable<Class, DataFlowInfo> getDataFlowTemplates() { return dfiTemplates; }

	public void cleanupBackendEnv() {
		this.benv = null;
	}

	public String toString() {
		return "<root>";
	}

	public void setLoggerLevel(LoggingLevel level) {
		level = loggingBuilderFactory.setLevel(level);
		switch (level) {
		case LoggingLevel.TRACE:   { verboseOn = true;  debugOn = true;  break; }
		case LoggingLevel.DEBUG:   { verboseOn = true;  debugOn = true;  break; }
		case LoggingLevel.INFO:    { verboseOn = true;  debugOn = false; break; }
		default:                   { verboseOn = false; debugOn = false; break; }
		}
	}
	public LoggingBuilderFactory getLogger() {
		return loggingBuilderFactory;
	}

	public LoggingEventBuilder reportAs(LoggingLevel level) {
		switch (level) {
		case LoggingLevel.TRACE:   return loggingBuilderFactory.newTrace();
		case LoggingLevel.DEBUG:   return loggingBuilderFactory.newDebug();
		case LoggingLevel.INFO:    return loggingBuilderFactory.newInfo();
		case LoggingLevel.WARNING: return loggingBuilderFactory.newWarning();
		case LoggingLevel.ERROR:   return loggingBuilderFactory.newError();
		case LoggingLevel.FATAL:   return loggingBuilderFactory.newFatalError();
		default:                   return loggingBuilderFactory.newFatalError();
		}
	}

	public LoggingEventBuilder reportTrace() {
		return loggingBuilderFactory.newTrace();
	}

	public LoggingEventBuilder reportDebug() {
		return loggingBuilderFactory.newDebug();
	}

	public LoggingEventBuilder reportInfo() {
		return loggingBuilderFactory.newInfo();
	}

	public LoggingEventBuilder reportWarning() {
		warningCounter.incrementAndGet();
		return loggingBuilderFactory.newWarning();
	}

	public LoggingEventBuilder reportError() {
		errorCounter.incrementAndGet();
		return loggingBuilderFactory.newError();
	}

	public LoggingEventBuilder reportFatalError() {
		errorCounter.incrementAndGet();
		return loggingBuilderFactory.newFatalError();
	}

	public void runFrontEndProcessorsOn(ANode node) {
		this.nodeProcessor.runFrontEndProcessorsOn(node);
	}

	public void runProcessorsOn(ANode node) {
		this.nodeProcessor.runProcessorsOn(node);
	}

	/** Environment initialization with specified backend */
	public void InitializeEnv(NodeProcessor processor, BEndEnvFactory benv_factory) {
		if (this.initialized)
			return;
		this.nodeProcessor = processor;

		this.root = new KievRoot(this);
		this.root.setContext(this.envContext);
		this.root.symbol.setContext(this.envContext);
		this.root.symbol.setUUID("7067fac2-59db-33f6-9094-60b0aff4ad95");

		this.tenv = new StdTypes(this, fun(StdTypes tenv)->void {
			this.tenv = tenv;
			this.envContext.setTypeEnv(tenv);
		});
		this.coreFuncs = new CoreFuncs(this);
		this.benv = benv_factory.makeBEndEnv(this);
		this.proj = new Project(envContext);

		//this.thisPar = new LVar(envContext);
		//this.thisPar.symbol.sname = Constants.nameThis;
		//this.thisPar.vtype = tenv.tpSelfTypeArg; // tpVoid?
		//this.thisPar.kind = Var.PARAM_THIS;
		//this.thisPar.nodeflags = Constants.ACC_FINAL | Constants.ACC_FORWARD | Constants.ACC_SYNTHETIC;

		//this.thisPar = new LVar(0L,Constants.nameThis,tenv.tpVoid,Var.PARAM_THIS,Constants.ACC_FINAL|Constants.ACC_FORWARD|Constants.ACC_SYNTHETIC);
		this.root.thisPar = new LVar(0L,Constants.nameThis,tenv.tpSelfTypeArg,Var.PARAM_THIS,Constants.ACC_FINAL|Constants.ACC_FORWARD|Constants.ACC_SYNTHETIC);

		this.addSpecialField("$GenAsserts", getTypeEnv().tpBoolean, new ConstBoolExpr(processor.genAssertsEnabled()));
		this.addSpecialField("$GenTraces",  getTypeEnv().tpBoolean, new ConstBoolExpr(processor.genTracesEnabled()));

		this.initialized = true;
	}

	public File makeNativeFile(String path) {
		File file = new File(path);
		if (file.isAbsolute())
			return file;
		return new File(proj.projectNativeRootDir, path);
	}

	private void addSpecialField(String name, Type tp, ENode init) {
		foreach (Field f; root.pkg_members; f.sname == name) {
			f.init = init;
			return;
		}
		Field f = new Field(name,tp,Constants.ACC_PUBLIC|Constants.ACC_STATIC|Constants.ACC_FINAL|Constants.ACC_SYNTHETIC);
		f.init = init;
		root.pkg_members.add(f);
	}

	public Symbol makeGlobalSymbol(String qname) {
		Symbol sym = null;
		Symbol psym = root.symbol;
		int s = 0;
		int e = qname.indexOf('·');
		for (;;) {
			String name = e < 0 ? qname.substring(s).intern() : qname.substring(s,e).intern();
			sym = null;
			foreach (Symbol sub; psym.sub_symbols; sub.sname == name) {
				sym = sub;
				break;
			}
			if (sym == null) {
				sym = new Symbol(name);
				psym.sub_symbols += sym;
			}
			psym = sym;
			if (e < 0)
				break;
			s = e+1;
			e = qname.indexOf('·', s);
		}
		return sym;
	}

	public DNode resolveGlobalDNode(String qname, ANodeContext context) {
		//assert(qname.indexOf('.') < 0);
		Symbol pkg = root.symbol;
		int start = 0;
		int end = qname.indexOf('·', start);
		while (end > 0) {
			String nm = qname.substring(start, end).intern();
			Symbol ss = null;
			foreach (Symbol s; pkg.sub_symbols; s.sname == nm) {
				ss = s;
				break;
			}
			if (ss == null)
				return null;
			pkg = ss;
			start = end+1;
			end = qname.indexOf('·', start);
		}
		String nm = qname.substring(start).intern();
		foreach (Symbol s; pkg.sub_symbols; s.sname == nm) {
			return s.deref<DNode>(context);
		}
		return null;
	}

	public synchronized void registerSymbol(SymUUID suuid) {
		Symbol old = this.uuidToSymbolMap.get(suuid);
		if (old != null) {
			Debug.assert("Registering another symbol with the same UUID ("+suuid+"):\n\t"+suuid.symbol);
			return;
		}
		this.uuidToSymbolMap.put(suuid);
	}

	public Symbol getSymbolByUUID(long high, long low) {
		return this.uuidToSymbolMap.get(new SymUUID(high, low, null));
	}
	public Symbol getSymbolByUUID(SymUUID suuid) {
		return this.uuidToSymbolMap.get(suuid);
	}
	public Symbol getSymbolByUUID(String uuid) {
		if (uuid == "")
			return null;
		SymUUID suuid = new SymUUID(uuid, null);
		return this.uuidToSymbolMap.get(suuid);
	}

	public synchronized Struct newStruct(String sname, DNode outer, int acces, Struct cl, String uuid)
	{
		Symbol sym = null;
		if (outer != null) {
			Symbol psym = outer.symbol;
			if (sname != null && psym.isGlobalSymbol())
				sym = psym.makeGlobalSubSymbol(sname);
		}
		if (sym == null)
			sym = new Symbol(sname);
		if (uuid != null && uuid != "")
			sym.setUUID(uuid);
		cl.symbol = sym;
		cl.nodeflags |= acces;
		if (outer != null) {
			MetaType mt = tenv.getExistingMetaType(sym);
			if (mt != null && mt.tdecl != cl)
				mt.tdecl.replaceWithNode(cl, mt.tdecl.parent(), mt.tdecl.pslot());
			else if (outer instanceof ComplexTypeDecl)
				outer.members += cl;
			else if (outer instanceof KievPackage)
				outer.pkg_members += cl;
		}
		tenv.callbackTypeVersionChanged(cl);
		return cl;
	}

	public synchronized KievPackage newPackage(String qname) {
		if (qname.isEmpty())
			return this.root;
		assert(qname.indexOf('.') < 0);
		int end = qname.lastIndexOf('·');
		if (end < 0)
			return newPackage(qname,root);
		else
			return newPackage(qname.substring(end+1),newPackage(qname.substring(0,end)));
	}

	public synchronized KievPackage newPackage(String sname, KievPackage outer) {
		sname = sname.intern();
		if (sname.indexOf(" ") >= 0)
			reportWarning().log("Creating a package with space in the name: '{}'", sname);
		foreach (KievPackage pkg; outer.pkg_members; pkg.sname == sname)
			return pkg;
		KievPackage pkg = new KievPackage(envContext, outer.symbol.makeGlobalSubSymbol(sname));
		outer.pkg_members += pkg;
		return pkg;
	}

	public static String getRelativePath(File f) throws IOException {
		return getRelativePath(f, new File("."));
	}
	private static String getRelativePath(File f, File home) throws IOException {
		Vector<String> homelist = getPathList(home);
		Vector<String> filelist = getPathList(f);
		String s = matchPathLists(homelist, filelist);
		return s;
	}
	private static Vector<String> getPathList(File f) throws IOException {
		Vector<String> l = new Vector<String>();
		File[] roots = File.listRoots();
		File r;
		r = f.getCanonicalFile();
		while (r != null && !Arrays.contains(roots, r)) {
			l.add(r.getName());
			r = r.getParentFile();
		}
		return l;
	}
	private static String matchPathLists(Vector<String> r, Vector<String> f) {
		// start at the beginning of the lists
		// iterate while both lists are equal
		String s = "";
		int i = r.size() - 1;
		int j = f.size() - 1;

		// first eliminate common root
		while (i >= 0 && j >= 0 && r.get(i).equals(f.get(j))) {
			i--;
			j--;
		}
		// for each remaining level in the home path, add a ..
		for (; i >= 0; i--)
			s += ".." + File.separator;
		// for each level in the file path, add the path
		for (; j >= 1; j--)
			s += f.get(j) + File.separator;
		// file name
		s += f.get(j);
		return s;
	}

	public boolean existsTypeDecl(String qname, ANodeContext context) {
		if (qname.isEmpty()) return true;
		if (context == null)
			context = envContext;
		return benv.existsTypeDecl(qname, context);
	}

	public TypeDecl loadTypeDecl(String qname, boolean fatal, ANodeContext context) {
		DNode dn = loadAnyDecl(qname, context);
		if (fatal && !(dn instanceof TypeDecl))
			throw new RuntimeException("Cannot find TypeDecl "+qname.replace('·','.'));
		return (TypeDecl)dn;
	}

	public TypeDecl loadTypeDecl(TypeDecl cl, ANodeContext context) {
		if (!cl.isTypeDeclNotLoaded())
			return cl;
		// Load if not loaded or not resolved
		DNode dn = resolveGlobalDNode(cl.qname(), context);
		if (dn instanceof TypeDecl) {
			if (!dn.isTypeDeclNotLoaded())
				return (TypeDecl)dn;
			cl = (TypeDecl)dn;
		}
		if (cl.isTypeDeclNotLoaded()) {
			if (cl instanceof Struct)
				return (TypeDecl)benv.actuallyLoadDecl((Struct)cl, context);
			else
				return (TypeDecl)benv.actuallyLoadDecl(cl.qname(), context);
		}
		return cl;
	}

	public DNode loadAnyDecl(String qname, ANodeContext context) {
		if (qname.length() == 0) return this.root;
		return benv.loadAnyDecl(qname, context);
	}

	public static INode getPrevNode(ANode node) {
		AttrSlot slot = node.pslot();
		if (slot instanceof ASpaceAttrSlot) {
			INode prev = null;
			foreach (INode n; slot.iterate(node.parent())) {
				if (node == n)
					return prev;
				prev = n;
			}
		}
		return null;
	}
	public static INode getNextNode(ANode node) {
		AttrSlot slot = node.pslot();
		if (slot instanceof ASpaceAttrSlot) {
			Enumeration<INode> iter = slot.iterate(node.parent());
			foreach (INode n; iter; node == n) {
				if (iter.hasMoreElements())
					return iter.nextElement();
				return null;
			}
		}
		return null;
	}

	public static ScalarPtr getScalarPtr(INode node, String name) {
		foreach (ScalarAttrSlot attr; node.values(); attr.name == name)
			return new ScalarPtr(node.asANode(), attr);
		throw new RuntimeException("No @nodeAttr/@nodeData attribute '"+name+"' in "+node.getClass());
	}

	public static SpacePtr getSpacePtr(INode node, String name) {
		foreach (SpaceAttrSlot attr; node.values(); attr.name == name)
			return new SpacePtr(node.asANode(), attr);
		throw new RuntimeException("No @nodeAttr/@nodeData space '"+name+"' in "+node.getClass());
	}

	public static boolean hasSameRoot(INode n1, INode n2) {
		return ctxRoot(n1) == ctxRoot(n2);
	}

	public static boolean needResolving(SymbolRef sref) {
		Symbol symb = sref.symbol;
		if (symb == null)
			return (sref.name != null && sref.name != "");
		else
			return !hasSameRoot(sref, symb);
	}

	public static INode ctxRoot(INode self) {
		while (self.isAttached())
			self = self.parent();
		return self;
	}

	public static ANode ctxRoot(ANode self) {
		while (self.isAttached())
			self = self.parent();
		return self;
	}

	public static FileUnit ctxFileUnit(INode self) {
		return ctxFileUnit((ANode)self);
	}
	public static FileUnit ctxFileUnit(ANode self) {
		if (self == null)
			return null;
		if (self instanceof FileUnit)
			return (FileUnit)self;
		for (;;) {
			ANode p = ANode.nodeattr$syntax_parent.get(self);
			if (p != null) {
				if (p instanceof FileUnit)
					return (FileUnit)p;
				self = p;
				continue;
			}
			p = self.parent();
			if (p != null) {
				if (p instanceof FileUnit)
					return (FileUnit)p;
				self = p;
				continue;
			}
			return null;
		}
	}
	public static SyntaxScope ctxSyntaxScope(INode self) {
		return ctxSyntaxScope((ANode)self);
	}
	public static SyntaxScope ctxSyntaxScope(ANode self) {
		if (self == null)
			return null;
		if (self instanceof SyntaxScope)
			return (SyntaxScope)self;
		for (;;) {
			ANode p = ANode.nodeattr$syntax_parent.get(self);
			if (p != null) {
				if (p instanceof SyntaxScope)
					return (SyntaxScope)p;
				self = p;
				continue;
			}
			p = self.parent();
			if (p != null) {
				if (p instanceof SyntaxScope)
					return (SyntaxScope)p;
				self = p;
				continue;
			}
			return null;
		}
	}

	public static ComplexTypeDecl ctxTDecl(ANode self) {
		if (self == null || self instanceof SyntaxScope)
			return null;
		return ctxChildTDecl(self.parent());
	}
	private static ComplexTypeDecl ctxChildTDecl(ANode self) {
		if (self == null || self instanceof SyntaxScope)
			return null;
		if (self instanceof ComplexTypeDecl)
			return (ComplexTypeDecl)self;
		return ctxChildTDecl(self.parent());
	}
	public static Method ctxMethod(ANode self) {
		if (self == null || self instanceof SyntaxScope)
			return null;
		return ctxChildMethod(self.parent());
	}
	private static Method ctxChildMethod(ANode self) {
		if (self == null || self instanceof SyntaxScope)
			return null;
		if (self instanceof Method)
			return (Method)self;
		return ctxChildMethod(self.parent());
	}


	class NodeCreator {
		final Class cl;
		final Language lang;
		final String name;
		final java.lang.reflect.Constructor ctor;
		final boolean deprecatedCtor;

		NodeCreator(Class cl) {
			this.cl = cl;

			ThisIsANode nodeAnnot = (ThisIsANode)cl.getAnnotation(ThisIsANode.class);
			if (nodeAnnot == null)
				throw new CompilerException("Class "+cl+" is not a node");
			this.name = nodeAnnot.name();

			Class langClass = nodeAnnot.lang();
			try {
				java.lang.reflect.Field newInstanceField = langClass.getField(Constants.nameInstance);
				this.lang = (Language)newInstanceField.get(langClass);
			} catch (Exception e) {
				try {
					this.lang = (Language)langClass.newInstance();
				} catch (Exception e) {
					this.lang = null;
				}
			}

			if (lang == null) {
				if (TypeInfoInterface.class.isAssignableFrom(cl)) {
					throw new RuntimeException("Node class '"+cl+"' needs run-time type info");
				} else {
					try {
						this.ctor = cl.getConstructor(ANodeContext.class);
					} catch (NoSuchMethodException e) {
						this.deprecatedCtor = true;
						this.ctor = cl.getConstructor();
					}
				}
			}
		}

		ANode newInstance(ANodeContext context) {
			if (lang != null) {
				if (name == null || name.isEmpty())
					return lang.makeNode(cl, context);
				return lang.makeNode(name, context);
			}
			if (deprecatedCtor) {
				ANode node = (ANode)ctor.newInstance();
				if (context != null)
					node.setContext(context);
				return node;
			}
			return (ANode)ctor.newInstance(context);
		}
	}

	public ANode newNode(Class cl, ANodeContext context) {
		NodeCreator creator = nodeTemplates.get(cl);
		if (creator == null) {
			creator = new NodeCreator(cl);
			nodeTemplates.put(cl, creator);
		}
		return creator.newInstance(context);
	}

}

